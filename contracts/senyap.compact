pragma language_version 0.23;
import CompactStandardLibrary;
import { LockedCard, encryptMembershipCard } from "./lib/LockedCardEncryption";

export struct ScoutGroup { side: Uint<8>; tier: Uint<8>; epoch: Uint<64>; ecosystem: Bytes<32>; }
export struct GroupLeaf { group: Bytes<32>; index: Uint<64>; }
export struct BuilderEntry { profileHash: Bytes<32>; ownerCommit: Bytes<32>; consent: Boolean; registeredAt: Uint<64>; }
export ledger builderRegistry: Map<Bytes<32>, BuilderEntry>;
export sealed ledger operator: Bytes<32>;
export sealed ledger committeeAuth: Vector<5, Bytes<32>>;
export ledger scoutGroups: Map<Bytes<32>, HistoricMerkleTree<20, Bytes<32>>>;
export ledger groupConfig: Map<Bytes<32>, ScoutGroup>;
export ledger groupSize: Map<Bytes<32>, Uint<32>>;
export ledger groupNextIndex: Map<Bytes<32>, Uint<64>>;
export ledger groupLeaves: Map<Bytes<32>, Bytes<32>>;
export ledger admittedCommitments: Set<Bytes<32>>;
export ledger approvalVotes: Set<Bytes<32>>;
export ledger approvalCounts: Map<Bytes<32>, Uint<8>>;
export ledger consumedRevocations: Set<Bytes<32>>;
export ledger buyerTree: HistoricMerkleTree<16, Bytes<32>>;
export ledger goodStanding: HistoricMerkleTree<16, Bytes<32>>;
export ledger admittedBuyers: Set<Bytes<32>>;
export struct Market {
  side: Uint<8>; category: Bytes<32>; questionHash: Bytes<32>; questionUri: Opaque<"string">;
  nOptions: Uint<8>; optionRefs: Vector<8, Bytes<32>>;
  openAt: Uint<64>; openUntil: Uint<64>; auctionUntil: Uint<64>; outcomeUntil: Uint<64>;
  flatPrice: Uint<64>; reservePrice: Uint<64>;
}
export ledger markets: Map<Uint<32>, Market>;
export ledger marketPhase: Map<Uint<32>, Uint<8>>;
export ledger marketCreator: Map<Uint<32>, Bytes<32>>;
export sealed ledger committeePk: JubjubPoint;
export sealed ledger dusdColor: Bytes<32>;
export sealed ledger epochLength: Uint<64>;
export sealed ledger hitWindow: Uint<64>;
export struct Histogram { strong: Uint<8>; medium: Uint<8>; weak: Uint<8>; }
export struct BuyerAccess { marketId: Uint<32>; bought: Vector<8, Boolean>; lockedCard: LockedCard; }
export struct PayoutDivision { quotient: Uint<128>; remainder: Uint<64>; }
export ledger previews: Map<Uint<32>, Histogram>;
export ledger buyerAccess: Map<Bytes<32>, BuyerAccess>;
export ledger marketPools: Map<Uint<32>, Vector<4, Uint<128>>>;
export ledger successMasks: Map<Uint<32>, Vector<4, Vector<8, Boolean>>>;
export ledger denominators: Map<Uint<32>, Vector<4, Uint<64>>>;
export ledger paidRewards: Map<Uint<32>, Vector<4, Uint<128>>>;
export ledger marketRevenue: Map<Uint<32>, Uint<128>>;
export ledger marketRemainder: Map<Uint<32>, Uint<128>>;
export ledger marketPositions: Map<Uint<32>, Uint<32>>;
export ledger marketClaims: Map<Uint<32>, Uint<32>>;
export ledger outcomeEvidence: Map<Uint<32>, Bytes<32>>;
export ledger hitUntil: Map<Uint<32>, Uint<64>>;
export ledger hitFlags: Map<Bytes<32>, Vector<4, Boolean>>;
export ledger issuedHits: Set<Bytes<32>>;
export ledger hitTree: HistoricMerkleTree<20, Bytes<32>>;
export struct CipherPair { c1: JubjubPoint; c2: JubjubPoint; }
export struct Position {
  marketId: Uint<32>; group: Bytes<32>; optionCommit: Bytes<32>; weight: Uint<64>; stake: Uint<128>;
  lockedCard: LockedCard; revealKeyCommit: Bytes<32>; status: Uint<8>;
}
export struct Division { quotient: Uint<64>; remainder: Uint<64>; }
struct PathIndex { value: Uint<64>; power: Uint<64>; }
export ledger positions: Map<Bytes<32>, Position>;
export ledger usedNullifiers: Set<Bytes<32>>;
export ledger usedOptions: Set<Bytes<32>>;
// Private predecessor proofs avoid a public Set lookup linking the scout's slots.
export ledger positionTree: HistoricMerkleTree<32, Bytes<32>>;
export ledger marketScouts: Map<Uint<32>, Uint<32>>;
export ledger marketWeight: Map<Uint<32>, Uint<64>>;
export ledger marketStake: Map<Uint<32>, Uint<128>>;
export ledger tally: Map<Uint<32>, Vector<8, CipherPair>>;

witness operatorSecret(): Bytes<32>;
witness committeeSecret(): Bytes<32>;
witness scoutSecret(): Bytes<32>;
witness memberPath(): MerkleTreePath<20, Bytes<32>>;
witness builderSecret(): Bytes<32>;
witness buyerSecret(): Bytes<32>;
witness buyerPath(): MerkleTreePath<16, Bytes<32>>;
witness standingPath(): MerkleTreePath<16, Bytes<32>>;
witness previousPositionPath(): MerkleTreePath<32, Bytes<32>>;
witness chosenOption(): Uint<8>;
witness optionSalt(): Bytes<32>;
witness randomnessHigh(): Vector<8, Uint<128>>;
witness randomnessLow(): Vector<8, Uint<128>>;
witness cardRandomHigh(): Uint<128>;
witness cardRandomLow(): Uint<128>;
witness divide(numerator: Uint<128>, denominator: Uint<64>): Division;
witness dividePayout(numerator: Uint<192>, denominator: Uint<64>): PayoutDivision;

constructor(operatorCommit: Bytes<32>, authCommits: Vector<5, Bytes<32>>, pk: JubjubPoint, color: Bytes<32>, epochSeconds: Uint<64>, hitSeconds: Uint<64>) {
  operator = disclose(operatorCommit);
  committeeAuth = disclose(authCommits);
  assert(epochSeconds > 0, "Epoch length must be positive");
  committeePk = disclose(pk);dusdColor = disclose(color);epochLength = disclose(epochSeconds);
  assert(hitSeconds > 0, "Hit registration window must be positive");hitWindow = disclose(hitSeconds);
  for (const i of [0, 1, 2, 3, 4]) {
    assert(authCommits[i] != default<Bytes<32>>, "Committee authentication must be nonzero");
    for (const j of [0, 1, 2, 3, 4]) {
      assert(i == j || authCommits[i] != authCommits[j], "Committee members must be distinct");
    }
  }
}

circuit assertOperator(): [] {
  assertOperatorKey(operatorSecret());
}
circuit assertOperatorKey(secret: Bytes<32>): [] {
  assert(persistentHash<Bytes<32>>(secret) == operator, "Operator authorization failed");
}

export circuit configureScoutGroup(group: Bytes<32>, config: ScoutGroup): [] {
  assertOperator();
  assert(!groupConfig.member(disclose(group)), "Group already configured");
  assert(config.side <= 1 && config.tier >= 1 && config.tier <= 3, "Invalid scout group");
  groupConfig.insert(disclose(group), disclose(config));
  scoutGroups.insert(disclose(group), default<HistoricMerkleTree<20, Bytes<32>>>);
  groupSize.insert(disclose(group), 0);
  groupNextIndex.insert(disclose(group), 0);
}

export circuit admitScout(group: Bytes<32>, commitment: Bytes<32>): [] {
  assertOperator();
  assert(groupConfig.member(disclose(group)), "Unknown scout group");
  assert(commitment != default<Bytes<32>>, "Empty commitment forbidden");
  const unique = persistentHash<Vector<2, Bytes<32>>>([group, commitment]);
  assert(!admittedCommitments.member(disclose(unique)), "Scout already admitted to group");
  const index = groupNextIndex.lookup(disclose(group));
  assert(index < 1048576, "Scout group tree full");
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  groupLeaves.insert(disclose(leafKey), disclose(commitment));
  scoutGroups.lookup(disclose(group)).insert(disclose(commitment));
  groupNextIndex.insert(disclose(group), (index + 1) as Uint<64>);
  groupSize.insert(disclose(group), (groupSize.lookup(disclose(group)) + 1) as Uint<32>);
  admittedCommitments.insert(disclose(unique));
}

circuit assertScout(group: Bytes<32>, secret: Bytes<32>): MerkleTreePath<20, Bytes<32>> {
  assert(groupConfig.member(disclose(group)), "Unknown scout group");
  const config = groupConfig.lookup(disclose(group));
  const commitment = persistentHash<Vector<2, Bytes<32>>>([secret, config.epoch as Bytes<32>]);
  const path = memberPath();
  assert(path.leaf == commitment, "Membership leaf does not belong to scout");
  assert(scoutGroups.lookup(disclose(group)).checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(path))), "Membership root not accepted");
  return path;
}

// Returns an unlinkable scope identifier, later reused by stake authorization.
export circuit scoutPseudonym(group: Bytes<32>, scope: Bytes<32>): Bytes<32> {
  const secret = scoutSecret();assertScout(group, secret);
  return disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:scout"), secret, scope]));
}

circuit revocationKey(group: Bytes<32>, index: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:revoke"), group, index as Bytes<32>]);
}

export circuit approveRevocation(group: Bytes<32>, index: Uint<64>, member: Uint<8>): [] {
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  assert(groupLeaves.member(disclose(leafKey)), "Unknown membership leaf");
  assert(member < 5, "Invalid committee member");
  const memberId = disclose(member);
  const auth = memberId == 0 ? committeeAuth[0] : memberId == 1 ? committeeAuth[1] : memberId == 2 ? committeeAuth[2] : memberId == 3 ? committeeAuth[3] : committeeAuth[4];
  assert(persistentHash<Bytes<32>>(committeeSecret()) == auth, "Committee authorization failed");
  const command = revocationKey(group, index);
  const vote = persistentHash<Vector<2, Bytes<32>>>([command, member as Bytes<32>]);
  assert(!consumedRevocations.member(disclose(command)), "Revocation already consumed");
  assert(!approvalVotes.member(disclose(vote)), "Duplicate committee approval");
  approvalVotes.insert(disclose(vote));
  const count = approvalCounts.member(disclose(command)) ? approvalCounts.lookup(disclose(command)) : 0;
  approvalCounts.insert(disclose(command), (count + 1) as Uint<8>);
}

export circuit revokeMember(group: Bytes<32>, index: Uint<64>): [] {
  assertOperator();
  const command = revocationKey(group, index);
  assert(!consumedRevocations.member(disclose(command)), "Revocation already consumed");
  assert(approvalCounts.member(disclose(command)), "Committee approvals required");
  assert(approvalCounts.lookup(disclose(command)) >= 3, "Three committee approvals required");
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  assert(groupLeaves.member(disclose(leafKey)), "Unknown membership leaf");
  groupLeaves.remove(disclose(leafKey));
  scoutGroups.lookup(disclose(group)).insertIndexDefault(disclose(index));
  scoutGroups.lookup(disclose(group)).resetHistory();
  groupSize.insert(disclose(group), (groupSize.lookup(disclose(group)) - 1) as Uint<32>);
  consumedRevocations.insert(disclose(command));
}

export circuit registerBuilder(id: Bytes<32>, profileHash: Bytes<32>, registeredAt: Uint<64>): [] {
  assert(id != default<Bytes<32>> && profileHash != default<Bytes<32>>, "Builder metadata required");
  const ownerCommit = persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:builder"), builderSecret()]);
  if (builderRegistry.member(disclose(id))) {
    const previous = builderRegistry.lookup(disclose(id));
    assert(!previous.consent, "Builder already registered");
    assert(previous.ownerCommit == ownerCommit, "Builder owner authorization failed");
  }
  assert(blockTimeGte(disclose(registeredAt)), "Registration timestamp is in future");
  assert(registeredAt <= 18446744073709551555, "Registration timestamp overflow");
  assert(blockTimeLt((disclose(registeredAt) + 60) as Uint<64>), "Registration timestamp is stale");
  builderRegistry.insert(disclose(id), disclose(BuilderEntry { profileHash: profileHash, ownerCommit: ownerCommit, consent: true, registeredAt: registeredAt }));
}

export circuit withdrawBuilder(id: Bytes<32>): [] {
  assert(builderRegistry.member(disclose(id)), "Unknown builder");
  const entry = builderRegistry.lookup(disclose(id));
  assert(entry.ownerCommit == persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:builder"), builderSecret()]), "Builder owner authorization failed");
  assert(entry.consent, "Builder already withdrawn");
  builderRegistry.insert(disclose(id), BuilderEntry { profileHash: entry.profileHash, ownerCommit: entry.ownerCommit, consent: false, registeredAt: entry.registeredAt });
}

export circuit admitBuyer(commitment: Bytes<32>): [] {
  assertOperator();
  assert(commitment != default<Bytes<32>>, "Empty buyer commitment forbidden");
  assert(!admittedBuyers.member(disclose(commitment)), "Buyer already admitted");
  buyerTree.insert(disclose(commitment));goodStanding.insert(disclose(commitment));
  admittedBuyers.insert(disclose(commitment));
}

circuit assertBuyer(secret: Bytes<32>): MerkleTreePath<16, Bytes<32>> {
  const commitment = persistentHash<Bytes<32>>(secret);
  const path = buyerPath();const standing = standingPath();
  assert(path.leaf == commitment && standing.leaf == commitment, "Buyer membership leaf does not belong to secret");
  assert(buyerTree.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))), "Buyer root not accepted");
  assert(goodStanding.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(standing))), "Buyer not in good standing");
  return path;
}

export circuit createMarket(id: Uint<32>, config: Market): [] {
  const cfg = disclose(config);const marketId = disclose(id);
  assert(!markets.member(marketId), "Market already exists");
  assert(cfg.side <= 1 && cfg.nOptions >= 1 && cfg.nOptions <= 8, "Invalid market side or option count");
  assert(cfg.questionHash != default<Bytes<32>> && cfg.category != default<Bytes<32>>, "Market metadata required");
  assert(cfg.openAt < cfg.openUntil && cfg.openUntil <= cfg.auctionUntil && cfg.auctionUntil < cfg.outcomeUntil, "Invalid market schedule");
  assert(blockTimeGte(cfg.openAt) && blockTimeLt(cfg.openUntil), "Market not in open window");
  const owner = cfg.side == 0 ? buyerSecret() : operatorSecret();
  // O-10: operator creates side B markets on verified builders' proposals.
  if (cfg.side == 0) { assertBuyer(owner); }
  else { assertOperatorKey(owner);assert(cfg.auctionUntil == cfg.openUntil, "Side B has no auction"); }
  for (const i of [0, 1, 2, 3, 4, 5, 6, 7]) {
    if (i < cfg.nOptions) {
      assert(cfg.optionRefs[i] != default<Bytes<32>>, "Empty active option");
      for (const j of [0, 1, 2, 3, 4, 5, 6, 7]) {
        assert(j >= cfg.nOptions || i == j || cfg.optionRefs[i] != cfg.optionRefs[j], "Duplicate market option");
      }
      if (cfg.side == 0) {
        assert(builderRegistry.member(cfg.optionRefs[i]), "Unknown option builder");
        assert(builderRegistry.lookup(cfg.optionRefs[i]).consent, "Builder has withdrawn consent");
      }
    } else { assert(cfg.optionRefs[i] == default<Bytes<32>>, "Unused option must be empty"); }
  }
  const creator = persistentHash<Vector<2, Bytes<32>>>([owner, marketId as Bytes<32>]);
  markets.insert(marketId, cfg);marketPhase.insert(marketId, 1);
  marketCreator.insert(marketId, disclose(creator));
  marketScouts.insert(marketId, 0);marketWeight.insert(marketId, 0);marketStake.insert(marketId, 0);
  marketPools.insert(marketId, [0,0,0,0]);denominators.insert(marketId, [0,0,0,0]);paidRewards.insert(marketId, [0,0,0,0]);
  marketRevenue.insert(marketId, 0);marketPositions.insert(marketId, 0);marketClaims.insert(marketId, 0);
  const emptyMask: Vector<8, Boolean> = [false,false,false,false,false,false,false,false];
  successMasks.insert(marketId, [emptyMask,emptyMask,emptyMask,emptyMask]);
  const zero = ecMulGenerator(0);
  tally.insert(marketId, map((i: Uint<8>): CipherPair => CipherPair { c1: zero, c2: zero }, [0,1,2,3,4,5,6,7]));
}

export circuit close(id: Uint<32>): [] {
  const marketId = disclose(id);
  assert(markets.member(marketId), "Unknown market");
  assert(marketPhase.lookup(marketId) == 1, "Market is not open");
  assert(blockTimeGte(markets.lookup(marketId).openUntil), "Market close time not reached");
  marketPhase.insert(marketId, 2);
}

circuit checkedDivide(n: Uint<128>, d: Uint<64>): Uint<64> {
  assert(d > 0, "Division denominator must be positive");
  const result = divide(n, d);
  assert(result.remainder < d && result.quotient * d + result.remainder == n, "Invalid division witness");
  return result.quotient;
}
circuit positionId(secret: Bytes<32>, market: Uint<32>, slot: Uint<8>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([pad(32, "senyap:position"), kernel.self().bytes, secret, market as Bytes<32>, slot as Bytes<32>]);
}
export circuit checkedMarketWeight(current: Uint<64>, addition: Uint<64>): Uint<64> {
  const total = current + addition;
  assert(total < 1099511627776, "Market total weight reaches decryption limit");
  return total as Uint<64>;
}

export circuit stake(id: Uint<32>, groupId: Bytes<32>, slotNumber: Uint<8>, amount: Uint<128>, revealKeyCommit: Bytes<32>): Bytes<32> {
  const marketId = disclose(id);const group = disclose(groupId);const slot = disclose(slotNumber);
  assert(markets.member(marketId) && marketPhase.lookup(marketId) == 1, "Market is not open");
  const market = markets.lookup(marketId);
  assert(blockTimeGte(market.openAt) && blockTimeLt(market.openUntil), "Stake outside open window");
  assert(slot >= 1 && slot <= 3, "Scout slot outside 1 to 3");
  assert(amount >= 10 && amount <= 500, "Stake outside 10 to 500 dUSD");
  const secret = scoutSecret();const path = assertScout(group, secret);const config = groupConfig.lookup(group);
  assert(groupSize.lookup(group) >= 5, "Scout group anonymity threshold not met");
  assert(config.side == market.side, "Scout group belongs to other market side");
  assert(config.epoch < 18446744073709551615, "Epoch overflow");
  assert(blockTimeGte((config.epoch * epochLength) as Uint<64>) && blockTimeLt(((config.epoch + 1) * epochLength) as Uint<64>), "Scout tier epoch expired");
  const nullifier = positionId(secret, marketId, slot);
  assert(!usedNullifiers.member(disclose(nullifier)), "Position nullifier already used");
  if (slot > 1) {
    const previous = previousPositionPath();
    assert(previous.leaf == positionId(secret, marketId, (slot - 1) as Uint<8>), "Previous position does not belong to scout");
    assert(positionTree.checkRoot(disclose(merkleTreePathRoot<32, Bytes<32>>(previous))), "Previous position root not accepted");
  }
  const option = chosenOption();const salt = optionSalt();
  assert(option < market.nOptions, "Option outside market");
  const optionId = persistentHash<Vector<5, Bytes<32>>>([pad(32, "senyap:option"), kernel.self().bytes, secret, marketId as Bytes<32>, option as Bytes<32>]);
  assert(!usedOptions.member(disclose(optionId)), "Scout already backed this option");
  for (const i of [0,1,2,3,4,5,6,7]) {
    assert(market.side == 0 || option != i || market.optionRefs[i] == config.ecosystem, "Scout ecosystem does not match option");
  }
  const quarter = checkedDivide((market.openUntil - market.openAt) as Uint<128>, 4);
  const early = blockTimeLt((market.openAt + disclose(quarter)) as Uint<64>);
  const multiplier = config.tier == 1 ? 100 : config.tier == 2 ? 125 : 150;
  const bonus = early ? 120 : 100;
  const weight = checkedDivide((amount * multiplier * bonus) as Uint<128>, 10000);
  assert(weight > 0 && weight < 4294967296, "Position weight outside range");
  const totalWeight = checkedMarketWeight(marketWeight.lookup(marketId), disclose(weight));
  const highs = randomnessHigh();const lows = randomnessLow();
  const sums = tally.lookup(marketId);
  const next = map((i: Uint<8>, sum: CipherPair, high: Uint<128>, low: Uint<128>): CipherPair => {
    assert(high < 19261898452744832053602769315862690560 || (high == 19261898452744832053602769315862690560 && low < 221192506920607668564158609621008198839), "Tally randomness outside subgroup");
    const r = (high as Field) * (340282366920938463463374607431768211456 as Field) + (low as Field);
    assert(r != 0, "Tally randomness must be nonzero");
    const value = option == i ? weight : 0;
    return CipherPair { c1: ecAdd(sum.c1, ecMulGenerator(r)), c2: ecAdd(sum.c2, ecAdd(ecMulGenerator(value as Field), ecMul(committeePk, r))) };
  }, [0,1,2,3,4,5,6,7], sums, highs, lows);
  const leafIndex = fold((acc: PathIndex, entry: MerkleTreePathEntry): PathIndex =>
    PathIndex { value: (acc.value + (entry.goes_left ? 0 : acc.power)) as Uint<64>, power: (acc.power * 2) as Uint<64> },
    PathIndex { value: 0, power: 1 }, path.path).value;
  const card = encryptMembershipCard(committeePk, path.leaf, leafIndex, nullifier, cardRandomHigh(), cardRandomLow());
  const optionCommit = persistentCommit<Uint<8>>(option, salt);
  assert(revealKeyCommit != default<Bytes<32>>, "Reveal key commitment required");
  receiveUnshielded(dusdColor, disclose(amount));
  positions.insert(disclose(nullifier), disclose(Position { marketId: marketId, group: group, optionCommit: optionCommit, weight: weight, stake: amount, lockedCard: card, revealKeyCommit: revealKeyCommit, status: 0 }));
  tally.insert(marketId, disclose(next));usedNullifiers.insert(disclose(nullifier));usedOptions.insert(disclose(optionId));positionTree.insert(disclose(nullifier));
  hitFlags.insert(disclose(nullifier), [false,false,false,false]);
  marketPositions.insert(marketId, (marketPositions.lookup(marketId) + 1) as Uint<32>);
  if (slot == 1) { marketScouts.insert(marketId, (marketScouts.lookup(marketId) + 1) as Uint<32>); }
  marketWeight.insert(marketId, totalWeight as Uint<64>);
  marketStake.insert(marketId, (marketStake.lookup(marketId) + disclose(amount)) as Uint<128>);
  return disclose(nullifier);
}

circuit approve(command: Bytes<32>, member: Uint<8>): Uint<8> {
  const memberId = disclose(member);assert(memberId < 5, "Invalid committee member");
  const auth = memberId == 0 ? committeeAuth[0] : memberId == 1 ? committeeAuth[1] : memberId == 2 ? committeeAuth[2] : memberId == 3 ? committeeAuth[3] : committeeAuth[4];
  assert(persistentHash<Bytes<32>>(committeeSecret()) == auth, "Committee authorization failed");
  const vote = persistentHash<Vector<2, Bytes<32>>>([command, memberId as Bytes<32>]);
  assert(!approvalVotes.member(disclose(vote)), "Duplicate committee approval");
  approvalVotes.insert(disclose(vote));
  const previous = approvalCounts.member(disclose(command)) ? approvalCounts.lookup(disclose(command)) : 0;
  const count = (previous + 1) as Uint<8>;approvalCounts.insert(disclose(command), count);return count;
}

export circuit postPreview(id: Uint<32>, histogram: Histogram, member: Uint<8>): [] {
  const marketId = disclose(id);const result = disclose(histogram);
  assert(marketPhase.lookup(marketId) == 2, "Market is not awaiting preview");
  assert(marketScouts.lookup(marketId) >= 5, "Market anonymity threshold not met");
  assert(result.strong >= 1 && result.strong + result.medium + result.weak == markets.lookup(marketId).nOptions, "Invalid histogram");
  const command = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:preview"), marketId as Bytes<32>, persistentHash<Histogram>(result)]);
  if (approve(command, member) >= 3) {
    previews.insert(marketId, result);
    marketPhase.insert(marketId, markets.lookup(marketId).side == 0 ? 4 : 3);
  }
}

circuit buyerId(secret: Bytes<32>, market: Uint<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([secret, market as Bytes<32>]);
}

// The side A allocation/auction gate is implemented separately in P4.
export circuit buyFlat(id: Uint<32>, optionNumber: Uint<8>): Bytes<32> {
  const marketId = disclose(id);const option = disclose(optionNumber);const market = markets.lookup(marketId);
  assert(market.side == 1, "Side A purchase requires auction allocation");
  const phase = marketPhase.lookup(marketId);
  assert((phase == 3 || phase == 6) && blockTimeLt(market.outcomeUntil), "Market not accepting purchases");
  assert(marketScouts.lookup(marketId) >= 5, "Market anonymity threshold not met");
  assert(option < market.nOptions, "Purchase option outside market");
  const secret = buyerSecret();const path = assertBuyer(secret);const pseudonym = buyerId(secret, marketId);
  const exists = buyerAccess.member(disclose(pseudonym));
  const previous: Vector<8, Boolean> = exists ? buyerAccess.lookup(disclose(pseudonym)).bought : [false,false,false,false,false,false,false,false];
  for (const i of [0,1,2,3,4,5,6,7]) { assert(option != i || !previous[i], "Option already purchased"); }
  const bought = map((i: Uint<8>, value: Boolean): Boolean => value || i == option, [0,1,2,3,4,5,6,7], previous);
  if (!exists) {
    const index = fold((acc: PathIndex, entry: MerkleTreePathEntry): PathIndex =>
      PathIndex { value: (acc.value + (entry.goes_left ? 0 : acc.power)) as Uint<64>, power: (acc.power * 2) as Uint<64> },
      PathIndex { value: 0, power: 1 }, path.path).value;
    const card = encryptMembershipCard(committeePk, path.leaf, index, pseudonym, cardRandomHigh(), cardRandomLow());
    buyerAccess.insert(disclose(pseudonym), disclose(BuyerAccess { marketId: marketId, bought: bought, lockedCard: card }));
  } else {
    const old = buyerAccess.lookup(disclose(pseudonym));
    buyerAccess.insert(disclose(pseudonym), BuyerAccess { ...old, bought: bought });
  }
  if (market.flatPrice > 0) { receiveUnshielded(dusdColor, market.flatPrice); }
  const pools = marketPools.lookup(marketId);
  marketPools.insert(marketId, [(pools[0] + market.flatPrice) as Uint<128>,pools[1],pools[2],pools[3]]);
  marketRevenue.insert(marketId, (marketRevenue.lookup(marketId) + market.flatPrice) as Uint<128>);
  marketPhase.insert(marketId, 6);return disclose(pseudonym);
}

export circuit recordOutcome(id: Uint<32>, mask: Vector<8, Boolean>, evidence: Bytes<32>, byOperator: Boolean): [] {
  const marketId = disclose(id);const market = markets.lookup(marketId);const phase = marketPhase.lookup(marketId);
  assert(market.side == 1, "Side A outcome requires buyer settlement slots");
  assert((phase == 3 || phase == 6) && !outcomeEvidence.member(marketId), "Outcome already recorded or market not ready");
  assert(blockTimeGte(market.auctionUntil) && blockTimeLt(market.outcomeUntil), "Outside outcome window");
  const isOperator = disclose(byOperator);const secret = isOperator ? operatorSecret() : buyerSecret();
  if (isOperator) { assertOperatorKey(secret); }
  else { assertBuyer(secret);assert(buyerAccess.member(disclose(buyerId(secret, marketId))), "Buyer has not purchased this market"); }
  assert(evidence != default<Bytes<32>>, "Outcome evidence required");
  const success = disclose(mask);
  for (const i of [0,1,2,3,4,5,6,7]) { assert(i < market.nOptions || !success[i], "Outcome includes unused option"); }
  const masks = successMasks.lookup(marketId);successMasks.insert(marketId, [success,masks[1],masks[2],masks[3]]);
  outcomeEvidence.insert(marketId, disclose(evidence));
  hitUntil.insert(marketId, (market.outcomeUntil + hitWindow) as Uint<64>);
  const any = fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, success);
  marketPhase.insert(marketId, any ? 8 : 7);
}

export circuit proveHit(id: Uint<32>, slotNumber: Uint<8>, poolNumber: Uint<8>): [] {
  const marketId = disclose(id);const pool = disclose(poolNumber);const market = markets.lookup(marketId);
  assert(pool < 4 && (market.side == 0 || pool == 0), "Invalid settlement pool");
  assert(marketPhase.lookup(marketId) == 8 && blockTimeLt(hitUntil.lookup(marketId)), "Hit registration window closed");
  const secret = scoutSecret();const nullifier = positionId(secret, marketId, slotNumber);
  assert(positions.member(disclose(nullifier)), "Unknown owned position");
  const position = positions.lookup(disclose(nullifier));assert(position.status == 0, "Position not active");
  const flags = hitFlags.lookup(disclose(nullifier));
  assert(!(pool == 0 ? flags[0] : pool == 1 ? flags[1] : pool == 2 ? flags[2] : flags[3]), "Hit already registered for pool");
  const option = chosenOption();const salt = optionSalt();
  assert(position.optionCommit == persistentCommit<Uint<8>>(option, salt), "Wrong committed option or salt");
  const masks = successMasks.lookup(marketId);const mask = pool == 0 ? masks[0] : pool == 1 ? masks[1] : pool == 2 ? masks[2] : masks[3];
  const matches = map((i: Uint<8>, value: Boolean): Boolean => option == i && value, [0,1,2,3,4,5,6,7], mask);
  assert(fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, matches), "Position is not a hit");
  const denoms = denominators.lookup(marketId);
  denominators.insert(marketId, map((i: Uint<8>, value: Uint<64>): Uint<64> => i == pool ? checkedMarketWeight(value, position.weight) : value, [0,1,2,3], denoms));
  hitFlags.insert(disclose(nullifier), map((i: Uint<8>, value: Boolean): Boolean => value || i == pool, [0,1,2,3], flags));
  const hitNullifier = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:hit"), nullifier, pool as Bytes<32>]);
  assert(!usedNullifiers.member(disclose(hitNullifier)), "Hit nullifier already used");usedNullifiers.insert(disclose(hitNullifier));
  if (!issuedHits.member(disclose(nullifier))) {
    hitTree.insert(disclose(persistentHash<Vector<2, Bytes<32>>>([secret, nullifier])));issuedHits.insert(disclose(nullifier));
  }
}

circuit payout(pool: Uint<128>, weight: Uint<64>, denominator: Uint<64>): Uint<128> {
  assert(denominator > 0 && denominator < 1099511627776 && weight <= denominator && weight < 4294967296, "Invalid payout denominator or weight");
  const n = (pool * 8500 * (weight as Uint<32>)) as Uint<192>;
  const d = (denominator * 10000) as Uint<64>;const result = dividePayout(n, d);
  assert(result.remainder < d && result.quotient * d + result.remainder == n, "Invalid payout division witness");
  return result.quotient;
}

export circuit claim(id: Uint<32>, slotNumber: Uint<8>, recipient: UserAddress): Uint<128> {
  const marketId = disclose(id);
  assert(marketPhase.lookup(marketId) == 8 && blockTimeGte(hitUntil.lookup(marketId)), "Claims not open");
  const secret = scoutSecret();const nullifier = positionId(secret, marketId, slotNumber);
  assert(positions.member(disclose(nullifier)), "Unknown owned position");
  const position = positions.lookup(disclose(nullifier));assert(position.status == 0, "Position already claimed or slashed");
  const claimId = persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:claim"), nullifier]);
  assert(!usedNullifiers.member(disclose(claimId)), "Claim nullifier already used");
  const flags = hitFlags.lookup(disclose(nullifier));const pools = marketPools.lookup(marketId);const denoms = denominators.lookup(marketId);
  const rewards = map((hit: Boolean, pool: Uint<128>, denom: Uint<64>): Uint<128> => hit ? payout(pool, position.weight, denom) : 0, flags, pools, denoms);
  const reward = fold((acc: Uint<128>, value: Uint<128>): Uint<128> => (acc + value) as Uint<128>, 0, rewards);
  const amount = (position.stake + reward) as Uint<128>;
  sendUnshielded(dusdColor, disclose(amount), right<ContractAddress, UserAddress>(disclose(recipient)));
  positions.insert(disclose(nullifier), Position { ...position, status: 1 });usedNullifiers.insert(disclose(claimId));
  const paid = paidRewards.lookup(marketId);
  const updated = map((a: Uint<128>, b: Uint<128>): Uint<128> => (a + b) as Uint<128>, paid, disclose(rewards));
  paidRewards.insert(marketId, updated);
  const claimed = (marketClaims.lookup(marketId) + 1) as Uint<32>;marketClaims.insert(marketId, claimed);
  if (claimed == marketPositions.lookup(marketId)) {
    const totalPaid = fold((acc: Uint<128>, value: Uint<128>): Uint<128> => (acc + value) as Uint<128>, 0, updated);
    marketRemainder.insert(marketId, (marketRevenue.lookup(marketId) - totalPaid) as Uint<128>);
    marketPhase.insert(marketId, 9);
  }
  return disclose(amount);
}
