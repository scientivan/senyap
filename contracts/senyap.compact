export sealed ledger disputeRevealWindow: Uint<64>;
export sealed ledger charity: UserAddress;

witness operatorSecret(): Bytes<32>;
witness committeeSecret(): Bytes<32>;
witness scoutSecret(): Bytes<32>;
witness memberPath(): MerkleTreePath<20, Bytes<32>>;
witness builderSecret(): Bytes<32>;
witness buyerSecret(): Bytes<32>;
witness buyerReceivingKey(): Bytes<32>;
witness buyerPath(): MerkleTreePath<16, Bytes<32>>;
witness standingPath(): MerkleTreePath<16, Bytes<32>>;
witness previousPositionPath(): MerkleTreePath<32, Bytes<32>>;
witness chosenOption(): Uint<8>;
witness optionSalt(): Bytes<32>;
witness randomnessHigh(): Vector<8, Uint<128>>;
witness randomnessLow(): Vector<8, Uint<128>>;
witness cardRandomHigh(): Uint<128>;
witness cardRandomLow(): Uint<128>;
witness divide(numerator: Uint<128>, denominator: Uint<64>): Division;
witness dividePayout(numerator: Uint<192>, denominator: Uint<64>): PayoutDivision;
witness bidAmount(): Uint<64>;
witness currentTime(): Uint<64>;
witness currentEpoch(): Uint<64>;
witness hitCredentials(): Vector<3, HitCredential>;
witness bidRandomHigh(): Uint<128>;
witness bidRandomLow(): Uint<128>;
witness verifierSecret(): Bytes<32>;
witness verifierPath(): MerkleTreePath<16, Bytes<32>>;
witness voteSalt(): Bytes<32>;

constructor(operatorCommit: Bytes<32>, authCommits: Vector<5, Bytes<32>>, pk: JubjubPoint, color: Bytes<32>, epochSeconds: Uint<64>, hitSeconds: Uint<64>, selectionSeconds: Uint<64>, commitSeconds: Uint<64>, revealSeconds: Uint<64>, charityAddress: UserAddress) {
  operator = disclose(operatorCommit);
  committeeAuth = disclose(authCommits);
  assert(epochSeconds > 0, "Epoch length must be positive");
  committeePk = disclose(pk);dusdColor = disclose(color);epochLength = disclose(epochSeconds);
  assert(hitSeconds > 0, "Hit registration window must be positive");hitWindow = disclose(hitSeconds);
  assert(selectionSeconds > 60, "Selection window must exceed timestamp tolerance");selectionWindow = disclose(selectionSeconds);
  assert(commitSeconds > 60 && revealSeconds > 0, "Invalid verifier windows");
  disputeCommitWindow = disclose(commitSeconds);disputeRevealWindow = disclose(revealSeconds);charity = disclose(charityAddress);
  for (const i of [0, 1, 2, 3, 4]) {
    assert(authCommits[i] != default<Bytes<32>>, "Committee authentication must be nonzero");
    for (const j of [0, 1, 2, 3, 4]) {
      assert(i == j || authCommits[i] != authCommits[j], "Committee members must be distinct");
    }
  }
}

circuit assertOperator(): [] {
  assertOperatorKey(operatorSecret());
}
circuit assertOperatorKey(secret: Bytes<32>): [] {
  assert(persistentHash<Bytes<32>>(secret) == operator, "Operator authorization failed");
}

export circuit configureScoutGroup(group: Bytes<32>, config: ScoutGroup): [] {
  assertOperator();
  assert(!groupConfig.member(disclose(group)), "Group already configured");
  assert(config.side <= 1 && config.tier >= 1 && config.tier <= 3, "Invalid scout group");
  groupConfig.insert(disclose(group), disclose(config));
  scoutGroups.insert(disclose(group), default<HistoricMerkleTree<20, Bytes<32>>>);
  groupSize.insert(disclose(group), 0);
  groupNextIndex.insert(disclose(group), 0);
}

export circuit admitScout(group: Bytes<32>, commitment: Bytes<32>): [] {
  assertOperator();
  assert(groupConfig.member(disclose(group)), "Unknown scout group");
  assert(commitment != default<Bytes<32>>, "Empty commitment forbidden");
  const unique = persistentHash<Vector<2, Bytes<32>>>([group, commitment]);
  assert(!admittedCommitments.member(disclose(unique)), "Scout already admitted to group");
  const index = groupNextIndex.lookup(disclose(group));
  assert(index < 1048576, "Scout group tree full");
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  groupLeaves.insert(disclose(leafKey), disclose(commitment));
  scoutGroups.lookup(disclose(group)).insert(disclose(commitment));
  groupNextIndex.insert(disclose(group), (index + 1) as Uint<64>);
  groupSize.insert(disclose(group), (groupSize.lookup(disclose(group)) + 1) as Uint<32>);
  admittedCommitments.insert(disclose(unique));
}

circuit assertScout(group: Bytes<32>, secret: Bytes<32>): MerkleTreePath<20, Bytes<32>> {
  assert(groupConfig.member(disclose(group)), "Unknown scout group");
  const config = groupConfig.lookup(disclose(group));
  const commitment = persistentHash<Vector<2, Bytes<32>>>([secret, config.epoch as Bytes<32>]);
  const path = memberPath();
  assert(path.leaf == commitment, "Membership leaf does not belong to scout");
  assert(scoutGroups.lookup(disclose(group)).checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(path))), "Membership root not accepted");
  return path;
}

// Returns an unlinkable scope identifier, later reused by stake authorization.
export circuit scoutPseudonym(group: Bytes<32>, scope: Bytes<32>): Bytes<32> {
  const secret = scoutSecret();assertScout(group, secret);
  return disclose(persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:scout"), secret, scope]));
}

circuit revocationKey(group: Bytes<32>, index: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:revoke"), group, index as Bytes<32>]);
}

export circuit approveRevocation(group: Bytes<32>, index: Uint<64>, member: Uint<8>): [] {
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  assert(groupLeaves.member(disclose(leafKey)), "Unknown membership leaf");
  assert(member < 5, "Invalid committee member");
  const memberId = disclose(member);
  const auth = memberId == 0 ? committeeAuth[0] : memberId == 1 ? committeeAuth[1] : memberId == 2 ? committeeAuth[2] : memberId == 3 ? committeeAuth[3] : committeeAuth[4];
  assert(persistentHash<Bytes<32>>(committeeSecret()) == auth, "Committee authorization failed");
  const command = revocationKey(group, index);
  const vote = persistentHash<Vector<2, Bytes<32>>>([command, member as Bytes<32>]);
  assert(!consumedRevocations.member(disclose(command)), "Revocation already consumed");
  assert(!approvalVotes.member(disclose(vote)), "Duplicate committee approval");
  approvalVotes.insert(disclose(vote));
  const count = approvalCounts.member(disclose(command)) ? approvalCounts.lookup(disclose(command)) : 0;
  approvalCounts.insert(disclose(command), (count + 1) as Uint<8>);
}

export circuit revokeMember(group: Bytes<32>, index: Uint<64>): [] {
  assertOperator();
  const command = revocationKey(group, index);
  assert(!consumedRevocations.member(disclose(command)), "Revocation already consumed");
  assert(approvalCounts.member(disclose(command)), "Committee approvals required");
  assert(approvalCounts.lookup(disclose(command)) >= 3, "Three committee approvals required");
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: group, index: index });
  assert(groupLeaves.member(disclose(leafKey)), "Unknown membership leaf");
  groupLeaves.remove(disclose(leafKey));
  scoutGroups.lookup(disclose(group)).insertIndexDefault(disclose(index));
  scoutGroups.lookup(disclose(group)).resetHistory();
  groupSize.insert(disclose(group), (groupSize.lookup(disclose(group)) - 1) as Uint<32>);
  consumedRevocations.insert(disclose(command));
}

export circuit registerBuilder(id: Bytes<32>, profileHash: Bytes<32>, registeredAt: Uint<64>): [] {
  assert(id != default<Bytes<32>> && profileHash != default<Bytes<32>>, "Builder metadata required");
  const ownerCommit = persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:builder"), builderSecret()]);
  if (builderRegistry.member(disclose(id))) {
    const previous = builderRegistry.lookup(disclose(id));
    assert(!previous.consent, "Builder already registered");
    assert(previous.ownerCommit == ownerCommit, "Builder owner authorization failed");
  }
  assert(blockTimeGte(disclose(registeredAt)), "Registration timestamp is in future");
  assert(registeredAt <= 18446744073709551555, "Registration timestamp overflow");
  assert(blockTimeLt((disclose(registeredAt) + 60) as Uint<64>), "Registration timestamp is stale");
  builderRegistry.insert(disclose(id), disclose(BuilderEntry { profileHash: profileHash, ownerCommit: ownerCommit, consent: true, registeredAt: registeredAt }));
}

export circuit withdrawBuilder(id: Bytes<32>): [] {
  assert(builderRegistry.member(disclose(id)), "Unknown builder");
  const entry = builderRegistry.lookup(disclose(id));
  assert(entry.ownerCommit == persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:builder"), builderSecret()]), "Builder owner authorization failed");
  assert(entry.consent, "Builder already withdrawn");
  builderRegistry.insert(disclose(id), BuilderEntry { profileHash: entry.profileHash, ownerCommit: entry.ownerCommit, consent: false, registeredAt: entry.registeredAt });
}

export circuit admitBuyer(commitment: Bytes<32>): [] {
  assertOperator();
  assert(commitment != default<Bytes<32>>, "Empty buyer commitment forbidden");
  assert(!admittedBuyers.member(disclose(commitment)), "Buyer already admitted");
  assert(buyerNextIndex < 65536, "Buyer membership tree full");
  buyerLeaves.insert(buyerNextIndex, disclose(commitment));buyerNextIndex = (buyerNextIndex + 1) as Uint<64>;
  buyerTree.insert(disclose(commitment));goodStanding.insert(disclose(commitment));
  admittedBuyers.insert(disclose(commitment));
}

circuit assertBuyer(secret: Bytes<32>): MerkleTreePath<16, Bytes<32>> {
  const commitment = persistentHash<Bytes<32>>(secret);
  const path = buyerPath();const standing = standingPath();
  assert(path.leaf == commitment && standing.leaf == commitment, "Buyer membership leaf does not belong to secret");
  assert(buyerTree.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))), "Buyer root not accepted");
  assert(goodStanding.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(standing))), "Buyer not in good standing");
  return path;
}

export circuit createMarket(id: Uint<32>, config: Market): [] {
  const cfg = disclose(config);const marketId = disclose(id);
  assert(!markets.member(marketId), "Market already exists");
  assert(cfg.side <= 1 && cfg.nOptions >= 1 && cfg.nOptions <= 8, "Invalid market side or option count");
  assert(cfg.questionHash != default<Bytes<32>> && cfg.category != default<Bytes<32>>, "Market metadata required");
  assert(cfg.openAt < cfg.openUntil && cfg.openUntil <= cfg.auctionUntil && cfg.auctionUntil < cfg.outcomeUntil, "Invalid market schedule");
  assert(blockTimeGte(cfg.openAt) && blockTimeLt(cfg.openUntil), "Market not in open window");
  const owner = cfg.side == 0 ? buyerSecret() : operatorSecret();
  for (const i of [0, 1, 2, 3, 4, 5, 6, 7]) {
    if (i < cfg.nOptions) {
      assert(cfg.optionRefs[i] != default<Bytes<32>>, "Empty active option");
      for (const j of [0, 1, 2, 3, 4, 5, 6, 7]) {
        assert(j >= cfg.nOptions || i == j || cfg.optionRefs[i] != cfg.optionRefs[j], "Duplicate market option");
      }
      if (cfg.side == 0) {
        assert(builderRegistry.member(cfg.optionRefs[i]), "Unknown option builder");
        assert(builderRegistry.lookup(cfg.optionRefs[i]).consent, "Builder has withdrawn consent");
      }
    } else { assert(cfg.optionRefs[i] == default<Bytes<32>>, "Unused option must be empty"); }
  }
  const creator = persistentHash<Vector<2, Bytes<32>>>([owner, marketId as Bytes<32>]);
  // O-10: operator creates side B markets on verified builders' proposals.
  if (cfg.side == 0) {
    const path = assertBuyer(owner);
    const card = makeBuyerCard(path, creator, cardRandomHigh(), cardRandomLow());
    marketCreatorCards.insert(marketId, disclose(card));
  } else { assertOperatorKey(owner);assert(cfg.auctionUntil == cfg.openUntil, "Side B has no auction"); }
  markets.insert(marketId, cfg);marketPhase.insert(marketId, 1);
  marketCreator.insert(marketId, disclose(creator));
  marketScouts.insert(marketId, 0);marketWeight.insert(marketId, 0);marketStake.insert(marketId, 0);
  pendingDisputes.insert(marketId, 0);
  marketPools.insert(marketId, [0,0,0,0]);denominators.insert(marketId, [0,0,0,0]);paidRewards.insert(marketId, [0,0,0,0]);
  hasPurchases.insert(marketId, false);marketRevenue.insert(marketId, 0);marketSubsidy.insert(marketId, 0);allocatedSubsidy.insert(marketId, 0);marketPositions.insert(marketId, 0);marketClaims.insert(marketId, 0);
  marketBuyers.insert(marketId, [default<Bytes<32>>,default<Bytes<32>>,default<Bytes<32>>,default<Bytes<32>>]);
  outcomesReady.insert(marketId, [false,false,false,false]);needsDefault.insert(marketId, [false,false,false,false]);
  const emptyMask: Vector<8, Boolean> = [false,false,false,false,false,false,false,false];
  successMasks.insert(marketId, [emptyMask,emptyMask,emptyMask,emptyMask]);
  purchasedOptions.insert(marketId, emptyMask);
  bidCount.insert(marketId, 0);bidEscrow.insert(marketId, 0);hiddenOptions.insert(marketId, [emptyMask,emptyMask]);
  const zero = ecMulGenerator(0);
  tally.insert(marketId, map((i: Uint<8>): CipherPair => CipherPair { c1: zero, c2: zero }, [0,1,2,3,4,5,6,7]));
}

export circuit close(id: Uint<32>): [] {
  const marketId = disclose(id);
  assert(markets.member(marketId), "Unknown market");
  assert(marketPhase.lookup(marketId) == 1, "Market is not open");
  assert(blockTimeGte(markets.lookup(marketId).openUntil), "Market close time not reached");
  marketPhase.insert(marketId, 2);
}

circuit checkedDivide(n: Uint<128>, d: Uint<64>): Uint<64> {
  assert(d > 0, "Division denominator must be positive");
  const result = divide(n, d);
  assert(result.remainder < d && result.quotient * d + result.remainder == n, "Invalid division witness");
  return result.quotient;
}
circuit positionId(secret: Bytes<32>, market: Uint<32>, slot: Uint<8>): Bytes<32> {
  return persistentHash<Vector<5, Bytes<32>>>([pad(32, "senyap:position"), kernel.self().bytes, secret, market as Bytes<32>, slot as Bytes<32>]);
}
export circuit checkedMarketWeight(current: Uint<64>, addition: Uint<64>): Uint<64> {
  const total = current + addition;
  assert(total < 1099511627776, "Market total weight reaches decryption limit");
  return total as Uint<64>;
}

export circuit stake(id: Uint<32>, groupId: Bytes<32>, slotNumber: Uint<8>, amount: Uint<128>, revealKeyCommit: Bytes<32>): Bytes<32> {
  const marketId = disclose(id);const group = disclose(groupId);const slot = disclose(slotNumber);
  assert(markets.member(marketId) && marketPhase.lookup(marketId) == 1, "Market is not open");
  const market = markets.lookup(marketId);
  assert(blockTimeGte(market.openAt) && blockTimeLt(market.openUntil), "Stake outside open window");
  assert(slot >= 1 && slot <= 3, "Scout slot outside 1 to 3");
  assert(amount >= 10 && amount <= 500, "Stake outside 10 to 500 dUSD");
  const secret = scoutSecret();const path = assertScout(group, secret);const config = groupConfig.lookup(group);
  assert(groupSize.lookup(group) >= 5, "Scout group anonymity threshold not met");
  assert(config.side == market.side, "Scout group belongs to other market side");
  assert(config.epoch < 18446744073709551615, "Epoch overflow");
  assert(blockTimeGte((config.epoch * epochLength) as Uint<64>) && blockTimeLt(((config.epoch + 1) * epochLength) as Uint<64>), "Scout tier epoch expired");
  const nullifier = positionId(secret, marketId, slot);
  assert(!usedNullifiers.member(disclose(nullifier)), "Position nullifier already used");
  if (slot > 1) {
    const previous = previousPositionPath();
    assert(previous.leaf == positionId(secret, marketId, (slot - 1) as Uint<8>), "Previous position does not belong to scout");
    assert(positionTree.checkRoot(disclose(merkleTreePathRoot<32, Bytes<32>>(previous))), "Previous position root not accepted");
  }
  const option = chosenOption();const salt = optionSalt();
  assert(option < market.nOptions, "Option outside market");
  const optionId = persistentHash<Vector<5, Bytes<32>>>([pad(32, "senyap:option"), kernel.self().bytes, secret, marketId as Bytes<32>, option as Bytes<32>]);
  assert(!usedOptions.member(disclose(optionId)), "Scout already backed this option");
  for (const i of [0,1,2,3,4,5,6,7]) {
    assert(market.side == 0 || option != i || market.optionRefs[i] == config.ecosystem, "Scout ecosystem does not match option");
  }
  const quarter = checkedDivide((market.openUntil - market.openAt) as Uint<128>, 4);
  const early = blockTimeLt((market.openAt + disclose(quarter)) as Uint<64>);
  const multiplier = config.tier == 1 ? 100 : config.tier == 2 ? 125 : 150;
  const bonus = early ? 120 : 100;
  const weight = checkedDivide((amount * multiplier * bonus) as Uint<128>, 10000);
  assert(weight > 0 && weight < 4294967296, "Position weight outside range");
  const totalWeight = checkedMarketWeight(marketWeight.lookup(marketId), disclose(weight));
  const highs = randomnessHigh();const lows = randomnessLow();
  const sums = tally.lookup(marketId);
  const next = map((i: Uint<8>, sum: CipherPair, high: Uint<128>, low: Uint<128>): CipherPair => {
    assert(high < 19261898452744832053602769315862690560 || (high == 19261898452744832053602769315862690560 && low < 221192506920607668564158609621008198839), "Tally randomness outside subgroup");
    const r = (high as Field) * (340282366920938463463374607431768211456 as Field) + (low as Field);
    assert(r != 0, "Tally randomness must be nonzero");
    const value = option == i ? weight : 0;
    return CipherPair { c1: ecAdd(sum.c1, ecMulGenerator(r)), c2: ecAdd(sum.c2, ecAdd(ecMulGenerator(value as Field), ecMul(committeePk, r))) };
  }, [0,1,2,3,4,5,6,7], sums, highs, lows);
  const leafIndex = fold((acc: PathIndex, entry: MerkleTreePathEntry): PathIndex =>
    PathIndex { value: (acc.value + (entry.goes_left ? 0 : acc.power)) as Uint<64>, power: (acc.power * 2) as Uint<64> },
    PathIndex { value: 0, power: 1 }, path.path).value;
  const card = encryptMembershipCard(committeePk, path.leaf, leafIndex, nullifier, cardRandomHigh(), cardRandomLow());
  const optionCommit = persistentCommit<Uint<8>>(option, salt);
  assert(revealKeyCommit != default<Bytes<32>>, "Reveal key commitment required");
  receiveUnshielded(dusdColor, disclose(amount));
  positions.insert(disclose(nullifier), disclose(Position { marketId: marketId, group: group, optionCommit: optionCommit, weight: weight, stake: amount, lockedCard: card, revealKeyCommit: revealKeyCommit, status: 0 }));
  tally.insert(marketId, disclose(next));usedNullifiers.insert(disclose(nullifier));usedOptions.insert(disclose(optionId));positionTree.insert(disclose(nullifier));
  hitFlags.insert(disclose(nullifier), [false,false,false,false]);
  marketPositions.insert(marketId, (marketPositions.lookup(marketId) + 1) as Uint<32>);
  if (slot == 1) { marketScouts.insert(marketId, (marketScouts.lookup(marketId) + 1) as Uint<32>); }
  marketWeight.insert(marketId, totalWeight as Uint<64>);
  marketStake.insert(marketId, (marketStake.lookup(marketId) + disclose(amount)) as Uint<128>);
  return disclose(nullifier);
}

circuit approve(command: Bytes<32>, member: Uint<8>): Uint<8> {
  const memberId = disclose(member);assert(memberId < 5, "Invalid committee member");
  const auth = memberId == 0 ? committeeAuth[0] : memberId == 1 ? committeeAuth[1] : memberId == 2 ? committeeAuth[2] : memberId == 3 ? committeeAuth[3] : committeeAuth[4];
  assert(persistentHash<Bytes<32>>(committeeSecret()) == auth, "Committee authorization failed");
  const vote = persistentHash<Vector<2, Bytes<32>>>([command, memberId as Bytes<32>]);
  assert(!approvalVotes.member(disclose(vote)), "Duplicate committee approval");
  approvalVotes.insert(disclose(vote));
  const previous = approvalCounts.member(disclose(command)) ? approvalCounts.lookup(disclose(command)) : 0;
  const count = (previous + 1) as Uint<8>;approvalCounts.insert(disclose(command), count);return count;
}

export circuit postPreview(id: Uint<32>, histogram: Histogram, member: Uint<8>): [] {
  const marketId = disclose(id);const result = disclose(histogram);
  assert(marketPhase.lookup(marketId) == 2, "Market is not awaiting preview");
  assert(marketScouts.lookup(marketId) >= 5, "Market anonymity threshold not met");
  assert(result.strong >= 1 && result.strong + result.medium + result.weak == markets.lookup(marketId).nOptions, "Invalid histogram");
  const command = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:preview"), marketId as Bytes<32>, persistentHash<Histogram>(result)]);
  if (approve(command, member) >= 3) {
    previews.insert(marketId, result);
    marketPhase.insert(marketId, markets.lookup(marketId).side == 0 ? 4 : 3);
  }
}

circuit buyerId(secret: Bytes<32>, market: Uint<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([secret, market as Bytes<32>]);
}
circuit makeBuyerCard(path: MerkleTreePath<16, Bytes<32>>, context: Bytes<32>, high: Uint<128>, low: Uint<128>): LockedCard {
  const index = fold((acc: PathIndex, entry: MerkleTreePathEntry): PathIndex =>
    PathIndex { value: (acc.value + (entry.goes_left ? 0 : acc.power)) as Uint<64>, power: (acc.power * 2) as Uint<64> },
    PathIndex { value: 0, power: 1 }, path.path).value;
  return encryptMembershipCard(committeePk, path.leaf, index, context, high, low);
}

export circuit placeBid(id: Uint<32>, ceiling: Uint<128>, refundRecipient: UserAddress): Bytes<32> {
  const marketId = disclose(id);const market = markets.lookup(marketId);
  assert(market.side == 0 && marketPhase.lookup(marketId) == 4, "Market is not in auction");
  assert(blockTimeGte(market.openUntil) && blockTimeLt(market.auctionUntil), "Outside auction window");
  assert(ceiling > 0 && ceiling >= market.reservePrice, "Bid ceiling below reserve");
  const secret = buyerSecret();const path = assertBuyer(secret);const pseudonym = buyerId(secret, marketId);
  assert(!bids.member(disclose(pseudonym)), "Buyer already bid in market");
  const amount = bidAmount();assert(amount > 0 && amount <= ceiling, "Bid exceeds ceiling or is zero");
  const high = bidRandomHigh();const low = bidRandomLow();
  assert(high < 19261898452744832053602769315862690560 || (high == 19261898452744832053602769315862690560 && low < 221192506920607668564158609621008198839), "Bid randomness outside subgroup");
  const r = (high as Field) * (340282366920938463463374607431768211456 as Field) + (low as Field);assert(r != 0, "Bid randomness must be nonzero");
  const enc = CipherPair { c1: ecMulGenerator(r), c2: ecAdd(ecMulGenerator(amount as Field), ecMul(committeePk, r)) };
  const context = persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:bid-envelope"), pseudonym]);
  const cardHigh = cardRandomHigh();const cardLow = cardRandomLow();
  const envelope = encryptMembershipCard(committeePk, amount as Bytes<32>, 0, context, cardHigh, cardLow);
  const card = makeBuyerCard(path, pseudonym, cardHigh, cardLow);
  const receivingKey = buyerReceivingKey();assert(receivingKey != default<Bytes<32>>, "Buyer receiving key must be nonzero");
  const empty: Vector<8, Boolean> = [false,false,false,false,false,false,false,false];
  buyerAccess.insert(disclose(pseudonym), disclose(BuyerAccess { marketId: marketId, bought: empty, receivingKey: receivingKey, lockedCard: card }));
  const sequence = bidCount.lookup(marketId);
  bids.insert(disclose(pseudonym), disclose(Bid { marketId: marketId, enc: enc, envelope: envelope, ceiling: ceiling, refundRecipient: refundRecipient, sequence: sequence, settled: false }));
  receiveUnshielded(dusdColor, disclose(ceiling));
  bidCount.insert(marketId, (sequence + 1) as Uint<32>);bidEscrow.insert(marketId, (bidEscrow.lookup(marketId) + disclose(ceiling)) as Uint<128>);
  return disclose(pseudonym);
}

export circuit postAuctionResult(id: Uint<32>, proposed: AuctionResult, member: Uint<8>): [] {
  const marketId = disclose(id);const result = disclose(proposed);const market = markets.lookup(marketId);
  assert(market.side == 0 && marketPhase.lookup(marketId) == 4 && blockTimeGte(market.auctionUntil), "Auction result not ready");
  const zero = default<Bytes<32>>;
  assert(result.first != zero || result.second == zero, "Second winner without first");
  assert(result.first == zero || result.first != result.second, "Auction winners must differ");
  assert(result.priceFirst >= result.priceSecond, "Auction prices out of order");
  if (result.first != zero) {
    assert(bids.member(result.first), "Unknown first winner");const bid = bids.lookup(result.first);
    assert(bid.marketId == marketId && result.priceFirst >= market.reservePrice && result.priceFirst <= bid.ceiling, "Invalid first winner price");
  } else { assert(result.priceFirst == 0, "Price without first winner"); }
  if (result.second != zero) {
    assert(bids.member(result.second), "Unknown second winner");const bid = bids.lookup(result.second);
    assert(bid.marketId == marketId && result.priceSecond >= market.reservePrice && result.priceSecond <= bid.ceiling, "Invalid second winner price");
  } else { assert(result.priceSecond == 0, "Price without second winner"); }
  const command = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:auction"), marketId as Bytes<32>, persistentHash<AuctionResult>(result)]);
  if (approve(command, member) >= 3) {
    const startedAt = disclose(currentTime());
    assert(blockTimeGte(startedAt), "Selection timestamp is in future");
    assert(blockTimeLt((startedAt + 61) as Uint<64>), "Selection timestamp is stale");
    const deadline = (startedAt + selectionWindow) as Uint<64>;
    assert(deadline < market.outcomeUntil, "Selection window exceeds outcome schedule");
    selectionDeadline.insert(marketId, deadline);
    hasPurchases.insert(marketId, result.first != zero);
    auctionResults.insert(marketId, result);selectionNext.insert(marketId, result.first == zero ? 2 : 0);marketPhase.insert(marketId, 5);
  }
}

export circuit settleBid(id: Uint<32>, pseudonym: Bytes<32>): [] {
  const marketId = disclose(id);const buyer = disclose(pseudonym);
  const bid = bids.lookup(buyer);
  assert(bid.marketId == marketId && !bid.settled, "Bid already settled or wrong market");
  if (marketPhase.lookup(marketId) == 10) {
    if (bid.ceiling > 0) { sendUnshielded(dusdColor, bid.ceiling, right<ContractAddress, UserAddress>(bid.refundRecipient)); }
    bids.insert(buyer, Bid { ...bid, settled: true });
    bidEscrow.insert(marketId, (bidEscrow.lookup(marketId) - bid.ceiling) as Uint<128>);
  } else {
  assert(auctionResults.member(marketId), "Auction result not finalized");
  const result = auctionResults.lookup(marketId);
  const first = buyer == result.first;const second = buyer == result.second;
  const price = first ? result.priceFirst : second ? result.priceSecond : 0;
  const refund = (bid.ceiling - price) as Uint<128>;
  if (refund > 0) { sendUnshielded(dusdColor, refund, right<ContractAddress, UserAddress>(bid.refundRecipient)); }
  bids.insert(buyer, Bid { ...bid, settled: true });bidEscrow.insert(marketId, (bidEscrow.lookup(marketId) - bid.ceiling) as Uint<128>);
  if (first || second) {
    const pools = marketPools.lookup(marketId);
    marketPools.insert(marketId, [first ? price : pools[0],second ? price : pools[1],pools[2],pools[3]]);
    marketRevenue.insert(marketId, (marketRevenue.lookup(marketId) + price) as Uint<128>);
    const owners = marketBuyers.lookup(marketId);
    marketBuyers.insert(marketId, [first ? buyer : owners[0],second ? buyer : owners[1],owners[2],owners[3]]);
  }
}

}

export circuit selectHidden(id: Uint<32>, selected: Vector<8, Boolean>): [] {
  const marketId = disclose(id);const rank = selectionNext.lookup(marketId);
  assert(blockTimeLt(selectionDeadline.lookup(marketId)), "Winner selection deadline reached");
  const secret = buyerSecret();assertBuyer(secret);const pseudonym = buyerId(secret, marketId);const result = auctionResults.lookup(marketId);
  assert(pseudonym == (rank == 0 ? result.first : result.second), "Wrong winner selection order");
  finishSelection(marketId, disclose(selected));
}

// Anyone may forfeit the pending winner's hiding choice after the common deadline.
// Paid signal access is preserved; an empty hiding mask cannot block later buyers.
export circuit skipSelection(id: Uint<32>): [] {
  const marketId = disclose(id);
  assert(blockTimeGte(selectionDeadline.lookup(marketId)), "Winner selection deadline not reached");
  finishSelection(marketId, [false,false,false,false,false,false,false,false]);
}

circuit finishSelection(marketId: Uint<32>, mask: Vector<8, Boolean>): [] {
  const market = markets.lookup(marketId);const rank = selectionNext.lookup(marketId);
  assert(market.side == 0 && marketPhase.lookup(marketId) == 5 && rank < 2, "Selection is not open");
  const result = auctionResults.lookup(marketId);const pseudonym = rank == 0 ? result.first : result.second;
  assert(bids.lookup(pseudonym).settled, "Settle winning bid before selection");
  const hidden = hiddenOptions.lookup(marketId);
  const count = fold((acc: Uint<8>, value: Boolean): Uint<8> => (acc + (value ? 1 : 0)) as Uint<8>, 0, mask);
  assert(count <= 3, "Winner can hide at most three options");
  for (const i of [0,1,2,3,4,5,6,7]) { assert((i < market.nOptions || !mask[i]) && (rank == 0 || !mask[i] || !hidden[0][i]), "Invalid or already hidden option"); }
  const visible = map((i: Uint<8>, taken: Boolean): Boolean => i < market.nOptions && (rank == 0 || !taken), [0,1,2,3,4,5,6,7], hidden[0]);
  const access = buyerAccess.lookup(pseudonym);buyerAccess.insert(pseudonym, BuyerAccess { ...access, bought: visible });
  hiddenOptions.insert(marketId, [rank == 0 ? mask : hidden[0],rank == 1 ? mask : hidden[1]]);
  selectionNext.insert(marketId, rank == 0 && result.second != default<Bytes<32>> ? 1 : 2);
}

export circuit buyFlat(id: Uint<32>, optionNumber: Uint<8>): Bytes<32> {
  const marketId = disclose(id);const option = disclose(optionNumber);const market = markets.lookup(marketId);
  const phase = marketPhase.lookup(marketId);
  assert((phase == 6 || (market.side == 1 ? phase == 3 : phase == 5)) && blockTimeLt(market.outcomeUntil), "Market not accepting purchases");
  assert(marketScouts.lookup(marketId) >= 5, "Market anonymity threshold not met");
  assert(option < market.nOptions, "Purchase option outside market");
  const secret = buyerSecret();const path = assertBuyer(secret);const pseudonym = disclose(buyerId(secret, marketId));
  const owners = marketBuyers.lookup(marketId);
  const pool: Uint<8> = market.side == 1 ? 0 : owners[2] == pseudonym ? 2 : owners[3] == pseudonym ? 3 : owners[2] == default<Bytes<32>> ? 2 : 3;
  if (market.side == 0) {
    assert(selectionNext.lookup(marketId) == 2, "Winner selection not finished");
    const result = auctionResults.lookup(marketId);
    assert(pseudonym != result.first && pseudonym != result.second, "Auction winner already has access");
    assert((owners[2] == pseudonym || owners[3] == pseudonym) || owners[2] == default<Bytes<32>> || owners[3] == default<Bytes<32>>, "Two flat buyers already joined");
    const hidden = hiddenOptions.lookup(marketId);
    for (const i of [0,1,2,3,4,5,6,7]) { assert(option != i || (!hidden[0][i] && !hidden[1][i]), "Option hidden by auction winner"); }
  }
  const exists = buyerAccess.member(disclose(pseudonym));
  const previous: Vector<8, Boolean> = exists ? buyerAccess.lookup(disclose(pseudonym)).bought : [false,false,false,false,false,false,false,false];
  for (const i of [0,1,2,3,4,5,6,7]) { assert(option != i || !previous[i], "Option already purchased"); }
  const bought = map((i: Uint<8>, value: Boolean): Boolean => value || i == option, [0,1,2,3,4,5,6,7], previous);
  if (!exists) {
    const index = fold((acc: PathIndex, entry: MerkleTreePathEntry): PathIndex =>
      PathIndex { value: (acc.value + (entry.goes_left ? 0 : acc.power)) as Uint<64>, power: (acc.power * 2) as Uint<64> },
      PathIndex { value: 0, power: 1 }, path.path).value;
    const card = encryptMembershipCard(committeePk, path.leaf, index, pseudonym, cardRandomHigh(), cardRandomLow());
    const receivingKey = buyerReceivingKey();assert(receivingKey != default<Bytes<32>>, "Buyer receiving key must be nonzero");
    buyerAccess.insert(disclose(pseudonym), disclose(BuyerAccess { marketId: marketId, bought: bought, receivingKey: receivingKey, lockedCard: card }));
  } else {
    const old = buyerAccess.lookup(disclose(pseudonym));
    buyerAccess.insert(disclose(pseudonym), BuyerAccess { ...old, bought: bought });
  }
  purchasedOptions.insert(marketId, map((i: Uint<8>, value: Boolean): Boolean => value || i == option, [0,1,2,3,4,5,6,7], purchasedOptions.lookup(marketId)));
  if (market.flatPrice > 0) { receiveUnshielded(dusdColor, market.flatPrice); }
  const pools = marketPools.lookup(marketId);
  marketPools.insert(marketId, map((i: Uint<8>, value: Uint<128>): Uint<128> => i == pool ? (value + market.flatPrice) as Uint<128> : value, [0,1,2,3], pools));
  if (market.side == 0) { marketBuyers.insert(marketId, [owners[0],owners[1],pool == 2 ? disclose(pseudonym) : owners[2],pool == 3 ? disclose(pseudonym) : owners[3]]); }
  hasPurchases.insert(marketId, true);
  marketRevenue.insert(marketId, (marketRevenue.lookup(marketId) + market.flatPrice) as Uint<128>);
  marketPhase.insert(marketId, 6);return disclose(pseudonym);
}

export circuit recordOutcome(id: Uint<32>, poolNumber: Uint<8>, mask: Vector<8, Boolean>, evidence: Bytes<32>, byOperator: Boolean): [] {
  const marketId = disclose(id);const market = markets.lookup(marketId);const phase = marketPhase.lookup(marketId);
  const pool = disclose(poolNumber);assert(pool < 4 && (market.side == 0 || pool == 0), "Invalid outcome pool");
  const key = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:outcome"), marketId as Bytes<32>, pool as Bytes<32>]);
  assert((phase == 3 || phase == 5 || phase == 6 || phase == 7) && !outcomeEvidence.member(disclose(key)), "Outcome already recorded or market not ready");
  assert(blockTimeGte(market.auctionUntil) && blockTimeLt(market.outcomeUntil), "Outside outcome window");
  const isOperator = disclose(byOperator);const secret = isOperator ? operatorSecret() : buyerSecret();
  const owners = marketBuyers.lookup(marketId);const owner = pool == 0 ? owners[0] : pool == 1 ? owners[1] : pool == 2 ? owners[2] : owners[3];
  if (market.side == 0) {
    assert(owner != default<Bytes<32>>, "Outcome pool has no buyer");assert(selectionNext.lookup(marketId) == 2, "Winner selection not finished");
    const result = auctionResults.lookup(marketId);
    if (result.first != default<Bytes<32>>) { assert(bids.lookup(result.first).settled, "Winning bids not settled"); }
    if (result.second != default<Bytes<32>>) { assert(bids.lookup(result.second).settled, "Winning bids not settled"); }
  }
  if (isOperator) { assertOperatorKey(secret); }
  else {
    assertBuyer(secret);const buyer = buyerId(secret, marketId);
    assert(buyerAccess.member(disclose(buyer)), "Buyer has not purchased this market");
    if (market.side == 0) { assert(buyer == owner, "Buyer does not own outcome pool"); }
    assert(fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, buyerAccess.lookup(disclose(buyer)).bought), "Buyer has not purchased this market");
  }
  assert(evidence != default<Bytes<32>>, "Outcome evidence required");
  const success = disclose(mask);
  for (const i of [0,1,2,3,4,5,6,7]) { assert(i < market.nOptions || !success[i], "Outcome includes unused option"); }
  if (market.side == 0) {
    const bought = buyerAccess.lookup(owner).bought;
    for (const i of [0,1,2,3,4,5,6,7]) { assert(!success[i] || bought[i], "Outcome includes unpurchased option"); }
  }
  const masks = successMasks.lookup(marketId);
  successMasks.insert(marketId, [pool == 0 ? success : masks[0],pool == 1 ? success : masks[1],pool == 2 ? success : masks[2],pool == 3 ? success : masks[3]]);
  outcomeEvidence.insert(disclose(key), disclose(evidence));
  const normalEnd = (market.outcomeUntil + hitWindow) as Uint<64>;
  const previousEnd = hitUntil.member(marketId) ? hitUntil.lookup(marketId) : 0;
  hitUntil.insert(marketId, previousEnd > normalEnd ? previousEnd : normalEnd);
  const any = fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, success);
  const ready = map((i: Uint<8>, value: Boolean): Boolean => i == pool ? any : value, [0,1,2,3], outcomesReady.lookup(marketId));
  outcomesReady.insert(marketId, ready);
  needsDefault.insert(marketId, map((i: Uint<8>, value: Boolean): Boolean => i == pool ? !any : value, [0,1,2,3], needsDefault.lookup(marketId)));
  const required = map((i: Uint<8>, buyer: Bytes<32>, value: Boolean): Boolean => (market.side == 1 ? i != 0 : buyer == default<Bytes<32>>) || value, [0,1,2,3], owners, ready);
  marketPhase.insert(marketId, fold((acc: Boolean, value: Boolean): Boolean => acc && value, true, required) ? 8 : 7);
}

// The committee attests which eligible option is strongest without publishing totals.
export circuit postDefaultStrongest(id: Uint<32>, poolNumber: Uint<8>, optionNumber: Uint<8>, member: Uint<8>): [] {
  const marketId = disclose(id);const pool = disclose(poolNumber);const option = disclose(optionNumber);const market = markets.lookup(marketId);
  assert(pool < 4 && (market.side == 0 || pool == 0), "Invalid default pool");
  assert(marketPhase.lookup(marketId) == 7, "Default selection is not pending");
  const pending = needsDefault.lookup(marketId);
  assert(pool == 0 ? pending[0] : pool == 1 ? pending[1] : pool == 2 ? pending[2] : pending[3], "Pool does not need a default");
  const owners = marketBuyers.lookup(marketId);const owner = pool == 0 ? owners[0] : pool == 1 ? owners[1] : pool == 2 ? owners[2] : owners[3];
  const eligible = market.side == 1 ? purchasedOptions.lookup(marketId) : buyerAccess.lookup(owner).bought;
  assert(option < market.nOptions, "Default option outside market");
  const allowed = map((i: Uint<8>, value: Boolean): Boolean => i == option && value, [0,1,2,3,4,5,6,7], eligible);
  assert(fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, allowed), "Default option was not purchased");
  const command = persistentHash<Vector<4, Bytes<32>>>([pad(32, "senyap:default"),marketId as Bytes<32>,pool as Bytes<32>,option as Bytes<32>]);
  if (approve(command, member) >= 3) {
    const renewedEnd = (checkedCurrentTime() + hitWindow) as Uint<64>;
    const previousEnd = hitUntil.lookup(marketId);hitUntil.insert(marketId, previousEnd > renewedEnd ? previousEnd : renewedEnd);
    const masks = successMasks.lookup(marketId);
    successMasks.insert(marketId, [pool == 0 ? allowed : masks[0],pool == 1 ? allowed : masks[1],pool == 2 ? allowed : masks[2],pool == 3 ? allowed : masks[3]]);
    const ready = map((i: Uint<8>, value: Boolean): Boolean => value || i == pool, [0,1,2,3], outcomesReady.lookup(marketId));
    outcomesReady.insert(marketId, ready);
    needsDefault.insert(marketId, map((i: Uint<8>, value: Boolean): Boolean => i == pool ? false : value, [0,1,2,3], pending));
    const required = map((i: Uint<8>, buyer: Bytes<32>, value: Boolean): Boolean => (market.side == 1 ? i != 0 : buyer == default<Bytes<32>>) || value, [0,1,2,3], owners, ready);
    marketPhase.insert(marketId, fold((acc: Boolean, value: Boolean): Boolean => acc && value, true, required) ? 8 : 7);
  }
}

export circuit proveHit(id: Uint<32>, slotNumber: Uint<8>, poolNumber: Uint<8>): [] {
  const marketId = disclose(id);const pool = disclose(poolNumber);const market = markets.lookup(marketId);
  assert(pool < 4 && (market.side == 0 || pool == 0), "Invalid settlement pool");
  assert(marketPhase.lookup(marketId) == 8 && blockTimeLt(hitUntil.lookup(marketId)), "Hit registration window closed");
  assert(blockTimeGte(market.outcomeUntil) && pendingDisputes.lookup(marketId) == 0, "Outcome or disputes still pending");
  const secret = scoutSecret();const nullifier = positionId(secret, marketId, slotNumber);
  assert(positions.member(disclose(nullifier)), "Unknown owned position");
  const position = positions.lookup(disclose(nullifier));assert(position.status == 0, "Position not active");
  const flags = hitFlags.lookup(disclose(nullifier));
  assert(!(pool == 0 ? flags[0] : pool == 1 ? flags[1] : pool == 2 ? flags[2] : flags[3]), "Hit already registered for pool");
  const option = chosenOption();const salt = optionSalt();
  assert(position.optionCommit == persistentCommit<Uint<8>>(option, salt), "Wrong committed option or salt");
  const masks = successMasks.lookup(marketId);const mask = pool == 0 ? masks[0] : pool == 1 ? masks[1] : pool == 2 ? masks[2] : masks[3];
  const matches = map((i: Uint<8>, value: Boolean): Boolean => option == i && value, [0,1,2,3,4,5,6,7], mask);
  assert(fold((acc: Boolean, value: Boolean): Boolean => acc || value, false, matches), "Position is not a hit");
  const denoms = denominators.lookup(marketId);
  denominators.insert(marketId, map((i: Uint<8>, value: Uint<64>): Uint<64> => i == pool ? checkedMarketWeight(value, position.weight) : value, [0,1,2,3], denoms));
  hitFlags.insert(disclose(nullifier), map((i: Uint<8>, value: Boolean): Boolean => value || i == pool, [0,1,2,3], flags));
  const hitNullifier = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:hit"), nullifier, pool as Bytes<32>]);
  assert(!usedNullifiers.member(disclose(hitNullifier)), "Hit nullifier already used");usedNullifiers.insert(disclose(hitNullifier));
  if (!issuedHits.member(disclose(nullifier))) {
    const epoch = disclose(currentEpoch());
    assert(blockTimeGte((epoch * epochLength) as Uint<64>) && blockTimeLt(((epoch + 1) * epochLength) as Uint<64>), "Hit credential epoch is not current");
    const credential = disclose(persistentHash<Vector<2, Bytes<32>>>([secret, nullifier]));
    if (!hitsByEpoch.member(epoch)) { hitsByEpoch.insert(epoch, default<HistoricMerkleTree<20, Bytes<32>>>); }
    hitsByEpoch.lookup(epoch).insert(credential);hitTree.insert(credential);issuedHits.insert(disclose(nullifier));
  }
}

circuit floorRatio(n: Uint<192>, d: Uint<64>): Uint<128> {
  assert(d > 0, "Division denominator must be positive");const result = dividePayout(n, d);
  assert(result.remainder < d && result.quotient * d + result.remainder == n, "Invalid payout division witness");return result.quotient;
}

circuit payout(pool: Uint<128>, subsidy: Uint<128>, weight: Uint<64>, denominator: Uint<64>): Uint<128> {
  assert(denominator > 0 && denominator < 1099511627776 && weight <= denominator && weight < 4294967296, "Invalid payout denominator or weight");
  // Buyer payments retain 85/15; the entire subsidy enters the reward basis.
  const n = ((pool * 8500 + subsidy * 10000) * (weight as Uint<32>)) as Uint<192>;
  return floorRatio(n, (denominator * 10000) as Uint<64>);
}

export circuit allocateSubsidy(sourceId: Uint<32>, targetId: Uint<32>, amount: Uint<128>): [] {
  assertOperator();const source = disclose(sourceId);const target = disclose(targetId);const grant = disclose(amount);
  assert(markets.lookup(source).side == 0 && markets.lookup(target).side == 1, "Subsidy must flow from side A to side B");
  const sourcePhase = marketPhase.lookup(source);const targetPhase = marketPhase.lookup(target);
  assert(sourcePhase >= 7 && sourcePhase <= 9, "Source revenue not frozen");
  assert((targetPhase == 3 || targetPhase == 6) && blockTimeLt(markets.lookup(target).outcomeUntil), "Target subsidy window closed");
  assert(marketScouts.lookup(target) >= 5, "Subsidy target anonymity threshold not met");
  const allowance = floorRatio((marketRevenue.lookup(source) * 500) as Uint<192>, 10000);
  const allocated = allocatedSubsidy.lookup(source);
  assert(grant > 0 && allocated + grant <= allowance, "Subsidy exceeds five percentage points of source revenue");
  const route = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:subsidy"), source as Bytes<32>, target as Bytes<32>]);
  const previousGrant = subsidyRoutes.member(route) ? subsidyRoutes.lookup(route).amount : 0;
  subsidyRoutes.insert(route, SubsidyRoute { source: source, target: target, amount: (previousGrant + grant) as Uint<128> });
  allocatedSubsidy.insert(source, (allocated + grant) as Uint<128>);
  const subsidy = (marketSubsidy.lookup(target) + grant) as Uint<128>;
  // Bound the total claimable buyer/subsidy funds before calculating rewards.
  const total = (marketRevenue.lookup(target) + subsidy) as Uint<128>;
  assert(total >= subsidy, "Subsidy accounting overflow");marketSubsidy.insert(target, subsidy);
  if (sourcePhase == 9) { marketRemainder.insert(source, (marketRemainder.lookup(source) - grant) as Uint<128>); }
}

export circuit cancelMarket(id: Uint<32>): [] {
  const marketId = disclose(id);const market = markets.lookup(marketId);const phase = marketPhase.lookup(marketId);
  assert(phase != 9 && phase != 10 && blockTimeGte(market.openUntil), "Market cancellation not ready");
  assert(!hasPurchases.lookup(marketId), "Purchased market cannot cancel");
  assert(marketScouts.lookup(marketId) < 5 || blockTimeGte(market.outcomeUntil), "Valid market purchase window still open");
  assert(marketRevenue.lookup(marketId) == 0 && pendingDisputes.lookup(marketId) == 0, "Cancellation funds unavailable");
  marketPhase.insert(marketId, 10);marketRemainder.insert(marketId, marketSubsidy.lookup(marketId));
}

export circuit returnCancelledSubsidy(sourceId: Uint<32>, targetId: Uint<32>): Uint<128> {
  const source = disclose(sourceId);const target = disclose(targetId);
  assert(markets.lookup(source).side == 0 && markets.lookup(target).side == 1 && marketPhase.lookup(target) == 10, "Subsidy target not cancelled");
  const route = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:subsidy"), source as Bytes<32>, target as Bytes<32>]);
  const allocation = subsidyRoutes.lookup(route);const amount = allocation.amount;
  assert(amount > 0, "Subsidy already returned");
  subsidyRoutes.insert(route, SubsidyRoute { ...allocation, amount: 0 });
  marketSubsidy.insert(target, (marketSubsidy.lookup(target) - amount) as Uint<128>);
  marketRemainder.insert(target, (marketRemainder.lookup(target) - amount) as Uint<128>);
  allocatedSubsidy.insert(source, (allocatedSubsidy.lookup(source) - amount) as Uint<128>);
  if (marketPhase.lookup(source) == 9) { marketRemainder.insert(source, (marketRemainder.lookup(source) + amount) as Uint<128>); }
  return amount;
}

export circuit claim(id: Uint<32>, slotNumber: Uint<8>, recipient: UserAddress): Uint<128> {
  const marketId = disclose(id);
  const cancelled = marketPhase.lookup(marketId) == 10;
  if (!cancelled) {
    assert(marketPhase.lookup(marketId) == 8 && blockTimeGte(hitUntil.lookup(marketId)), "Claims not open");
    assert(blockTimeGte(markets.lookup(marketId).outcomeUntil) && pendingDisputes.lookup(marketId) == 0, "Outcome or disputes still pending");
  }
  const secret = scoutSecret();const nullifier = positionId(secret, marketId, slotNumber);
  assert(positions.member(disclose(nullifier)), "Unknown owned position");
  const position = positions.lookup(disclose(nullifier));assert(position.status == 0, "Position already claimed or slashed");
  const claimId = persistentHash<Vector<2, Bytes<32>>>([pad(32, "senyap:claim"), nullifier]);
  assert(!usedNullifiers.member(disclose(claimId)), "Claim nullifier already used");
  const flags = hitFlags.lookup(disclose(nullifier));const pools = marketPools.lookup(marketId);const denoms = denominators.lookup(marketId);
  const subsidy = marketSubsidy.lookup(marketId);
  const rewards = map((hit: Boolean, pool: Uint<128>, denom: Uint<64>): Uint<128> => !cancelled && hit ? payout(pool, subsidy, position.weight, denom) : 0, flags, pools, denoms);
  const reward = fold((acc: Uint<128>, value: Uint<128>): Uint<128> => (acc + value) as Uint<128>, 0, rewards);
  const amount = (position.stake + reward) as Uint<128>;
  sendUnshielded(dusdColor, disclose(amount), right<ContractAddress, UserAddress>(disclose(recipient)));
  positions.insert(disclose(nullifier), Position { ...position, status: 1 });usedNullifiers.insert(disclose(claimId));
  const paid = paidRewards.lookup(marketId);
  const updated = map((a: Uint<128>, b: Uint<128>): Uint<128> => (a + b) as Uint<128>, paid, disclose(rewards));
  paidRewards.insert(marketId, updated);
  const claimed = (marketClaims.lookup(marketId) + 1) as Uint<32>;marketClaims.insert(marketId, claimed);
  if (!cancelled && claimed == marketPositions.lookup(marketId)) {
    const totalPaid = fold((acc: Uint<128>, value: Uint<128>): Uint<128> => (acc + value) as Uint<128>, 0, updated);
    marketRemainder.insert(marketId, (marketRevenue.lookup(marketId) + marketSubsidy.lookup(marketId) - totalPaid - allocatedSubsidy.lookup(marketId)) as Uint<128>);
    marketPhase.insert(marketId, 9);
  }
  return disclose(amount);
}


export circuit renewTier(fromGroup: Bytes<32>, toGroup: Bytes<32>): [] {
  const sourceId = disclose(fromGroup);const targetId = disclose(toGroup);const secret = scoutSecret();
  assertScout(sourceId, secret);
  assert(groupConfig.member(targetId), "Unknown renewal group");
  const source = groupConfig.lookup(sourceId);const target = groupConfig.lookup(targetId);
  assert(blockTimeGte((source.epoch * epochLength) as Uint<64>) && blockTimeLt(((source.epoch + 1) * epochLength) as Uint<64>), "Renew before current tier epoch expires");
  assert(target.epoch == source.epoch + 1 && target.side == source.side && target.ecosystem == source.ecosystem, "Renewal must keep side/ecosystem in next epoch");
  assert(target.tier >= source.tier && target.tier <= source.tier + 2, "Invalid renewed tier");
  const required: Uint<8> = target.tier == source.tier ? 1 : target.tier == source.tier + 1 ? 2 : 3;
  const credentials = hitCredentials();
  for (const i of [0,1,2]) {
    if (i < required) {
      const credential = credentials[i];
      assert(credential.epoch <= source.epoch && credential.epoch + 1 >= source.epoch && (target.tier == source.tier || credential.epoch == source.epoch), "Hit credential is too old for requested tier");
      const leaf = persistentHash<Vector<2, Bytes<32>>>([secret, credential.position]);
      assert(credential.path.leaf == leaf, "Hit credential does not belong to scout");
      assert(hitsByEpoch.member(disclose(credential.epoch)), "Unknown hit credential epoch");
      assert(hitsByEpoch.lookup(disclose(credential.epoch)).checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(credential.path))), "Hit credential root not accepted");
      const used = persistentHash<Vector<5, Bytes<32>>>([pad(32, "senyap:renew-hit"),kernel.self().bytes,secret,credential.position,target.epoch as Bytes<32>]);
      assert(!usedNullifiers.member(disclose(used)), "Hit credential already used in target epoch");usedNullifiers.insert(disclose(used));
    }
  }
  const renewal = persistentHash<Vector<6, Bytes<32>>>([pad(32, "senyap:renew"),kernel.self().bytes,secret,target.epoch as Bytes<32>,target.side as Bytes<32>,target.ecosystem]);
  assert(!usedNullifiers.member(disclose(renewal)), "Scout already renewed for target epoch");
  const commitment = persistentHash<Vector<2, Bytes<32>>>([secret,target.epoch as Bytes<32>]);
  const unique = persistentHash<Vector<2, Bytes<32>>>([targetId,commitment]);
  assert(!admittedCommitments.member(disclose(unique)), "Scout already admitted to renewal group");
  const index = groupNextIndex.lookup(targetId);assert(index < 1048576, "Scout group tree full");
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: targetId, index: index });
  groupLeaves.insert(disclose(leafKey), disclose(commitment));scoutGroups.lookup(targetId).insert(disclose(commitment));
  groupNextIndex.insert(targetId, (index + 1) as Uint<64>);groupSize.insert(targetId, (groupSize.lookup(targetId) + 1) as Uint<32>);
  admittedCommitments.insert(disclose(unique));usedNullifiers.insert(disclose(renewal));
}


// All deposits are demo unshielded dUSD. Membership is private; vote choice is
// public only during reveal. The first seven commitments reserve the seats.
export circuit admitVerifier(commitment: Bytes<32>): [] {
  assertOperator();assert(commitment != default<Bytes<32>>, "Empty verifier commitment");
  assert(!admittedVerifiers.member(disclose(commitment)), "Verifier already admitted");
  admittedVerifiers.insert(disclose(commitment));verifierTree.insert(disclose(commitment));
}
circuit checkedCurrentTime(): Uint<64> {
  const now = disclose(currentTime());
  assert(now <= 18446744073709551554 && blockTimeGte(now) && blockTimeLt((now + 61) as Uint<64>), "Invalid current timestamp");
  return now;
}
export circuit openDispute(positionId: Bytes<32>, evidence: Bytes<32>, reporter: UserAddress): [] {
  const id = disclose(positionId);const position = positions.lookup(id);const market = markets.lookup(position.marketId);
  assert(position.status == 0 && blockTimeLt(market.outcomeUntil), "Dispute opening window closed");
  assert(marketScouts.lookup(position.marketId) >= 5 && hasPurchases.lookup(position.marketId), "Dispute requires valid purchased market");
  assert(!disputes.member(id), "Position already disputed");assert(evidence != default<Bytes<32>>, "Dispute evidence required");
  const now = checkedCurrentTime();const commitUntil = (now + disputeCommitWindow) as Uint<64>;
  const revealUntil = (commitUntil + disputeRevealWindow) as Uint<64>;
  receiveUnshielded(dusdColor, 50);
  const zero = default<Bytes<32>>;
  disputes.insert(id, Dispute { marketId: position.marketId, evidence: disclose(evidence), reporter: disclose(reporter), commitUntil: commitUntil,
    revealUntil: revealUntil, seats: [zero,zero,zero,zero,zero,zero,zero], committed: 0, yes: 0, no: 0, result: 0, majorityBonus: 0 });
  pendingDisputes.insert(position.marketId, (pendingDisputes.lookup(position.marketId) + 1) as Uint<32>);
  const end = (revealUntil + hitWindow) as Uint<64>;
  const previous = hitUntil.member(position.marketId) ? hitUntil.lookup(position.marketId) : 0;
  hitUntil.insert(position.marketId, previous > end ? previous : end);
}
circuit verifierPseudonym(secret: Bytes<32>, id: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "senyap:verifier"), kernel.self().bytes, secret, id]);
}
export circuit commitVote(dispute: Bytes<32>, commitment: Bytes<32>, recipient: UserAddress): Bytes<32> {
  const id = disclose(dispute);const item = disputes.lookup(id);
  assert(item.result == 0 && blockTimeLt(item.commitUntil), "Vote commit window closed");
  assert(item.committed < 7, "Seven verifier seats already filled");assert(commitment != default<Bytes<32>>, "Empty vote commitment");
  const secret = verifierSecret();const path = verifierPath();
  assert(path.leaf == persistentHash<Bytes<32>>(secret), "Verifier leaf does not belong to secret");
  assert(verifierTree.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))), "Verifier root not accepted");
  const pseudonym = disclose(verifierPseudonym(secret, id));
  assert(!verifierVotes.member(pseudonym), "Verifier already committed in this dispute");
  receiveUnshielded(dusdColor, 100);
  verifierVotes.insert(pseudonym, VerifierVote { dispute: id, commitment: disclose(commitment), recipient: disclose(recipient), revealed: false, choice: false, claimed: false });
  const seats = map((i: Uint<8>, seat: Bytes<32>): Bytes<32> => i == item.committed ? pseudonym : seat, [0,1,2,3,4,5,6], item.seats);
  disputes.insert(id, Dispute { ...item, seats: seats, committed: (item.committed + 1) as Uint<8> });
  return pseudonym;
}
export circuit revealVote(dispute: Bytes<32>, choice: Boolean): [] {
  const id = disclose(dispute);const item = disputes.lookup(id);
  assert(item.result == 0 && blockTimeGte(item.commitUntil) && blockTimeLt(item.revealUntil), "Vote reveal window closed");
  const secret = verifierSecret();const pseudonym = disclose(verifierPseudonym(secret, id));const vote = verifierVotes.lookup(pseudonym);
  assert(!vote.revealed, "Vote already revealed");
  const committed = persistentHash<Vector<6, Bytes<32>>>([pad(32, "senyap:vote"),kernel.self().bytes,id,secret,choice ? (1 as Bytes<32>) : default<Bytes<32>>,voteSalt()]);
  assert(vote.commitment == committed, "Wrong vote choice or salt");
  verifierVotes.insert(pseudonym, VerifierVote { ...vote, revealed: true, choice: disclose(choice) });
  disputes.insert(id, Dispute { ...item, yes: (item.yes + (disclose(choice) ? 1 : 0)) as Uint<8>, no: (item.no + (disclose(choice) ? 0 : 1)) as Uint<8> });
}
export circuit resolveDispute(dispute: Bytes<32>): Uint<8> {
  const id = disclose(dispute);const item = disputes.lookup(id);
  assert(item.result == 0 && blockTimeGte(item.revealUntil), "Dispute not ready to resolve");
  const valid = item.yes + item.no >= 5 && item.yes != item.no;
  const hoax = item.yes > item.no;const majority = hoax ? item.yes : item.no;
  const penalties = fold((total: Uint<64>, seat: Bytes<32>): Uint<64> => {
    if (seat == default<Bytes<32>>) { return total; }
    const vote = verifierVotes.lookup(seat);
    return (total + (!vote.revealed ? 100 : vote.choice != hoax ? 50 : 0)) as Uint<64>;
  }, 0, item.seats);
  const pool: Uint<64> = valid ? (penalties + (hoax ? 0 : 50)) as Uint<64> : 0;
  const bonus: Uint<64> = valid ? checkedDivide(pool as Uint<128>, majority as Uint<64>) : 0;
  const result: Uint<8> = !valid ? 3 : hoax ? 1 : 2;
  disputes.insert(id, Dispute { ...item, result: result, majorityBonus: disclose(bonus) });
  disputeRemainder.insert(id, disclose(valid ? (pool - bonus * majority) as Uint<64> : 0));
  if (!valid || hoax) { sendUnshielded(dusdColor, 50, right<ContractAddress, UserAddress>(item.reporter)); }
  if (valid && hoax) {
    const position = positions.lookup(id);assert(position.status == 0, "Disputed position not active");
    sendUnshielded(dusdColor, position.stake, right<ContractAddress, UserAddress>(charity));
    positions.insert(id, Position { ...position, status: 2 });
    marketClaims.insert(item.marketId, (marketClaims.lookup(item.marketId) + 1) as Uint<32>);
  }
  pendingDisputes.insert(item.marketId, (pendingDisputes.lookup(item.marketId) - 1) as Uint<32>);
  // A late finalizer must still leave a complete hit window after all cases close.
  const end = (checkedCurrentTime() + hitWindow) as Uint<64>;
  const previous = hitUntil.lookup(item.marketId);hitUntil.insert(item.marketId, previous > end ? previous : end);
  return result;
}
export circuit claimVerifier(pseudonym: Bytes<32>): Uint<64> {
  const key = disclose(pseudonym);const vote = verifierVotes.lookup(key);const item = disputes.lookup(vote.dispute);
  assert(item.result != 0 && !vote.claimed, "Verifier claim not available");
  const principal: Uint<64> = item.result == 3 ? 100 : !vote.revealed ? 0 : vote.choice == (item.result == 1) ? 100 : 50;
  const bonus: Uint<64> = item.result != 3 && vote.revealed && vote.choice == (item.result == 1) ? item.majorityBonus : 0;
  const amount = (principal + bonus) as Uint<64>;
  if (amount > 0) { sendUnshielded(dusdColor, amount, right<ContractAddress, UserAddress>(vote.recipient)); }
  verifierVotes.insert(key, VerifierVote { ...vote, claimed: true });return amount;
}

// A proven hoax unlocks committee disclosure of this card. Three matching
// authenticated attestations bind the decrypted member index to that exact card.
export circuit approveHoaxMember(dispute: Bytes<32>, index: Uint<64>, member: Uint<8>): [] {
  const id = disclose(dispute);assert(disputes.lookup(id).result == 1, "Hoax not proven");
  assert(!hoaxMembers.member(id), "Hoax member already revealed");const position = positions.lookup(id);
  const leafKey = persistentHash<GroupLeaf>(GroupLeaf { group: position.group, index: index });
  assert(groupLeaves.member(disclose(leafKey)), "Unknown hoax member index");
  const command = persistentHash<Vector<4, Bytes<32>>>([pad(32, "senyap:hoax-member"),id,persistentHash<LockedCard>(position.lockedCard),index as Bytes<32>]);
  if (approve(command, member) >= 3) { hoaxMembers.insert(id, GroupLeaf { group: position.group, index: disclose(index) }); }
}
export circuit revokeHoaxMember(dispute: Bytes<32>): [] {
  assertOperator();const id = disclose(dispute);assert(disputes.lookup(id).result == 1 && hoaxMembers.member(id), "Hoax member not revealed");
  const member = hoaxMembers.lookup(id);const leafKey = persistentHash<GroupLeaf>(member);
  assert(groupLeaves.member(leafKey), "Hoax member already revoked");
  groupLeaves.remove(leafKey);scoutGroups.lookup(member.group).insertIndexDefault(member.index);scoutGroups.lookup(member.group).resetHistory();
  groupSize.insert(member.group, (groupSize.lookup(member.group) - 1) as Uint<32>);
}
// Handles the case where every position was slashed, so nobody can call claim.
export circuit finalizeMarket(id: Uint<32>): [] {
  const marketId = disclose(id);
  assert(marketPhase.lookup(marketId) == 8 && blockTimeGte(hitUntil.lookup(marketId)) && pendingDisputes.lookup(marketId) == 0, "Market not ready to finalize");
  assert(marketClaims.lookup(marketId) == marketPositions.lookup(marketId), "Positions still unclaimed");
  const paid = fold((acc: Uint<128>, value: Uint<128>): Uint<128> => (acc + value) as Uint<128>, 0, paidRewards.lookup(marketId));
  marketRemainder.insert(marketId, (marketRevenue.lookup(marketId) + marketSubsidy.lookup(marketId) - paid - allocatedSubsidy.lookup(marketId)) as Uint<128>);
  marketPhase.insert(marketId, 9);
}

// Side B uses a shared outcome. Its missed-report responsibility is awaiting
// Dien's decision; do not infer per-buyer penalties from a shared pool.
export circuit markMissedReport(id: Uint<32>, poolNumber: Uint<8>): [] {
  const marketId = disclose(id);const pool = disclose(poolNumber);const market = markets.lookup(marketId);
  assert(market.side == 0 && pool < 4, "Only side A buyer pools are supported here");
  assert(blockTimeGte(market.outcomeUntil), "Outcome reporting window still open");
  const phase = marketPhase.lookup(marketId);assert(phase >= 5 && phase <= 7 && selectionNext.lookup(marketId) == 2, "Market not ready for missed reports");
  const owners = marketBuyers.lookup(marketId);const owner = pool == 0 ? owners[0] : pool == 1 ? owners[1] : pool == 2 ? owners[2] : owners[3];
  assert(owner != default<Bytes<32>>, "Outcome pool has no buyer");
  const key = persistentHash<Vector<3, Bytes<32>>>([pad(32, "senyap:outcome"),marketId as Bytes<32>,pool as Bytes<32>]);
  assert(!outcomeEvidence.member(disclose(key)), "Outcome or missed report already recorded");
  outcomeEvidence.insert(disclose(key), default<Bytes<32>>);missedReports.insert(owner);
  needsDefault.insert(marketId, map((i: Uint<8>, value: Boolean): Boolean => value || i == pool, [0,1,2,3], needsDefault.lookup(marketId)));
  const end = (checkedCurrentTime() + hitWindow) as Uint<64>;const previous = hitUntil.member(marketId) ? hitUntil.lookup(marketId) : 0;
  hitUntil.insert(marketId, previous > end ? previous : end);marketPhase.insert(marketId, 7);
}
export circuit approveMissedBuyer(pseudonym: Bytes<32>, index: Uint<64>, member: Uint<8>): [] {
  const buyer = disclose(pseudonym);assert(missedReports.member(buyer), "Buyer has no missed report");
  assert(!missedBuyerIndices.member(buyer), "Buyer member already revealed");
  assert(buyerLeaves.member(disclose(index)), "Unknown buyer member index");
  const access = buyerAccess.lookup(buyer);
  const command = persistentHash<Vector<4, Bytes<32>>>([pad(32, "senyap:missed-buyer"),buyer,persistentHash<LockedCard>(access.lockedCard),index as Bytes<32>]);
  if (approve(command, member) >= 3) { missedBuyerIndices.insert(buyer, disclose(index)); }
}
export circuit revokeMissedBuyer(pseudonym: Bytes<32>): [] {
  assertOperator();const buyer = disclose(pseudonym);assert(missedReports.member(buyer) && missedBuyerIndices.member(buyer), "Missed buyer member not revealed");
  const index = missedBuyerIndices.lookup(buyer);const leaf = buyerLeaves.lookup(index);
  assert(!removedStanding.member(leaf), "Buyer standing already removed");
  goodStanding.insertIndexDefault(index);goodStanding.resetHistory();removedStanding.insert(leaf);
}
