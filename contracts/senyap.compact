export ledger hitsByEpoch: Map<Uint<64>, HistoricMerkleTree<20, Bytes<32>>>;
export struct HitCredential { position: Bytes<32>; epoch: Uint<64>; path: MerkleTreePath<20, Bytes<32>>; }
export ledger marketCreatorCards: Map<Uint<32>, LockedCard>;
export struct Bid {
  marketId: Uint<32>; enc: CipherPair; envelope: LockedCard; ceiling: Uint<128>;
