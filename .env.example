# Public defaults and empty placeholders only. Never commit actual credentials.
# Local network uses undeployed; the planned demo network is preprod.
MIDNIGHT_NETWORK=preprod
PROOF_SERVER_URL=http://localhost:6300

# Server-only credentials. Set these yourself in an ignored .env file.
# Never expose any of these through apps/web or a VITE_* variable.
BLOCKFROST_PROJECT_ID_PREPROD=
DEPLOYER_SEED=
OPERATOR_SECRET=
COMMITTEE_SHARE_1=
COMMITTEE_SHARE_2=
COMMITTEE_SHARE_3=
COMMITTEE_SHARE_4=
COMMITTEE_SHARE_5=
COMMITTEE_AUTH_SECRET_1=
COMMITTEE_AUTH_SECRET_2=
COMMITTEE_AUTH_SECRET_3=
COMMITTEE_AUTH_SECRET_4=
COMMITTEE_AUTH_SECRET_5=
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_PROVIDER_ID=

# Public frontend deployment configuration for /app/preprod. No credentials.
# Missing or invalid values keep live access disabled; demo routes stay labelled.
# Endpoints here cannot contain username/password or query-string tokens.
VITE_SENYAP_CONTRACT_ADDRESS=
VITE_MIDNIGHT_NODE_URL=
VITE_MIDNIGHT_GENESIS_HASH=
VITE_SENYAP_OPERATOR_COMMITMENT=
VITE_OPERATOR_API_URL=
VITE_COMMITTEE_URLS=

# Fixed public service binding. Do not accept these values from HTTP requests.
MIDNIGHT_NODE_URL=
MIDNIGHT_INDEXER_URL=
MIDNIGHT_GENESIS_HASH=
SENYAP_CONTRACT_ADDRESS=
SENYAP_OPERATOR_COMMITMENT=

# Local service process settings. Use separate role env files, each with only
# that member's one private share, or only the operator reason key.
SENYAP_APP_ORIGIN=http://127.0.0.1:5174
SENYAP_COMMITTEE_PUBLIC_KEY=
SENYAP_COMMITTEE_PUBLIC_SHARES=
COMMITTEE_PORT=
OPERATOR_PORT=
OPERATOR_REASON_PUBLIC_KEY=
OPERATOR_REASON_PRIVATE_KEY_PKCS8=

# Public X25519 key for encrypted reason delivery (never the private key)
VITE_OPERATOR_REASON_PUBLIC_KEY=
